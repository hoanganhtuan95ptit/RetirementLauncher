<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Toolbar -->
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnClean"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:id="@+id/frame_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="16dp">

            <!-- Scanner ring -->
            <FrameLayout
                android:layout_width="188dp"
                android:layout_height="188dp"
                android:layout_gravity="center_horizontal">

                <com.simple.launcher.retirement.presentation.clean_files.ScannerRingView
                    android:id="@+id/scannerRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Center of ring -->
                <LinearLayout
                    android:id="@+id/llRingCenter"
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ring_center"
                    android:elevation="1dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivRingIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        tools:src="@drawable/ic_clear_files_black_24dp" />

                    <TextView
                        android:id="@+id/tvRingCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:visibility="gone"
                        tools:text="55"
                        tools:visibility="visible" />
                </LinearLayout>
            </FrameLayout>

            <!-- Status text -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                tools:text="@string/clean_files_desc" />

            <LinearLayout
                android:id="@+id/llCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="?android:attr/colorBackground"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_result_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    tools:text="@string/clean_result_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- Files deleted -->
                    <LinearLayout
                        android:id="@+id/frame_ResultFiles"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_result_stat"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivResultFiles"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginBottom="4dp"
                            android:contentDescription="@null"
                            tools:src="@drawable/ic_home_cleanup_24dp" />

                        <TextView
                            android:id="@+id/tvResultFiles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="55" />
                    </LinearLayout>

                    <!-- Space freed -->
                    <LinearLayout
                        android:id="@+id/frame_ResultSpace"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_result_stat"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivResultSpace"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginBottom="4dp"
                            android:contentDescription="@null"
                            tools:src="@drawable/ic_home_drives_24dp" />

                        <TextView
                            android:id="@+id/tvResultSpace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="15 MB" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Action button pinned at bottom -->
    <include
        android:id="@+id/btnClean"
        layout="@layout/layout_action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animation_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:lottie_rawRes="@raw/congratulations" />
</androidx.constraintlayout.widget.ConstraintLayout>
