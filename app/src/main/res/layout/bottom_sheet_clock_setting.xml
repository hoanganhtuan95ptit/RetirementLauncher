<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/setting_clock_title"
        android:textColor="@android:color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvFormatHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/setting_clock_format_header"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- 12h Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl12h"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_clock_format_card"
        android:padding="16dp"
        app:layout_constraintEnd_toStartOf="@+id/cl24h"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFormatHeader">

        <ImageView
            android:id="@+id/ivRadio12h"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_radio_unselected"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv12hTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/setting_clock_12h"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/ivRadio12h"
            app:layout_constraintStart_toEndOf="@id/ivRadio12h"
            app:layout_constraintTop_toTopOf="@id/ivRadio12h" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/setting_clock_12h_example"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tv12hTitle"
            app:layout_constraintTop_toBottomOf="@id/tv12hTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 24h Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl24h"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_clock_format_card"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="@id/cl12h"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cl12h"
        app:layout_constraintTop_toTopOf="@id/cl12h">

        <ImageView
            android:id="@+id/ivRadio24h"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_radio_unselected"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv24hTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/setting_clock_24h"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/ivRadio24h"
            app:layout_constraintStart_toEndOf="@id/ivRadio24h"
            app:layout_constraintTop_toTopOf="@id/ivRadio24h" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/setting_clock_24h_example"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tv24hTitle"
            app:layout_constraintTop_toBottomOf="@id/tv24hTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/divider1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="#F2F2F7"
        app:layout_constraintTop_toBottomOf="@id/cl12h" />

    <!-- AM/PM Item -->
    <ImageView
        android:id="@+id/ivAmPm"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_clock_icon_green"
        android:padding="8dp"
        android:src="@drawable/ic_am_pm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider1" />

    <TextView
        android:id="@+id/tvAmPmTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/setting_clock_am_pm"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/swAmPm"
        app:layout_constraintStart_toEndOf="@id/ivAmPm"
        app:layout_constraintTop_toTopOf="@id/ivAmPm" />

    <TextView
        android:id="@+id/tvAmPmDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/setting_clock_am_pm_desc"
        android:textColor="#8E8E93"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/tvAmPmTitle"
        app:layout_constraintStart_toStartOf="@id/tvAmPmTitle"
        app:layout_constraintTop_toBottomOf="@id/tvAmPmTitle" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swAmPm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/ivAmPm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivAmPm" />

    <View
        android:id="@+id/divider2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#F2F2F7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvAmPmTitle"
        app:layout_constraintTop_toBottomOf="@id/tvAmPmDesc" />

    <!-- Solar Calendar Item -->
    <ImageView
        android:id="@+id/ivSolar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_clock_icon_green"
        android:padding="8dp"
        android:src="@drawable/ic_sun"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider2" />

    <TextView
        android:id="@+id/tvSolarTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/setting_clock_solar"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/swSolar"
        app:layout_constraintStart_toEndOf="@id/ivSolar"
        app:layout_constraintTop_toTopOf="@id/ivSolar" />

    <TextView
        android:id="@+id/tvSolarDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/setting_clock_solar_desc"
        android:textColor="#8E8E93"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/tvSolarTitle"
        app:layout_constraintStart_toStartOf="@id/tvSolarTitle"
        app:layout_constraintTop_toBottomOf="@id/tvSolarTitle" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swSolar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/ivSolar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivSolar" />

    <View
        android:id="@+id/divider3"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#F2F2F7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvSolarTitle"
        app:layout_constraintTop_toBottomOf="@id/tvSolarDesc" />

    <!-- Lunar Calendar Item -->
    <ImageView
        android:id="@+id/ivLunar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_clock_icon_purple"
        android:padding="8dp"
        android:src="@drawable/ic_moon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider3" />

    <TextView
        android:id="@+id/tvLunarTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/setting_clock_lunar"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/swLunar"
        app:layout_constraintStart_toEndOf="@id/ivLunar"
        app:layout_constraintTop_toTopOf="@id/ivLunar" />

    <TextView
        android:id="@+id/tvLunarDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/setting_clock_lunar_desc"
        android:textColor="#8E8E93"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/tvLunarTitle"
        app:layout_constraintStart_toStartOf="@id/tvLunarTitle"
        app:layout_constraintTop_toBottomOf="@id/tvLunarTitle" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swLunar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/ivLunar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivLunar" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvLunarDesc">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_block_app_pill"
            android:gravity="center"
            android:text="@string/back"
            android:textColor="#58C27D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_block_app_pill"
            android:backgroundTint="#58C27D"
            android:gravity="center"
            android:text="@string/save"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
