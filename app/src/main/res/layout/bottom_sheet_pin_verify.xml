<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Xác nhận mã PIN"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Vui lòng nhập mã PIN để thay đổi thiết lập này."
        android:textColor="?android:attr/textColorSecondary" />

    <!-- PIN dot indicators -->
    <LinearLayout
        android:id="@+id/llPinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/vPin1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/vPin2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/vPin3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/vPin4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/vPin5"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/vPin6"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

    </LinearLayout>

    <!-- Numpad: 4 hàng x 3 cột dùng LinearLayout -->
    <LinearLayout
        android:id="@+id/llNumpad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <!-- Row 1: 1 2 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnKey1"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="1" />

            <TextView
                android:id="@+id/btnKey2"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="2" />

            <TextView
                android:id="@+id/btnKey3"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="3" />

        </LinearLayout>

        <!-- Row 2: 4 5 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnKey4"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="4" />

            <TextView
                android:id="@+id/btnKey5"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="5" />

            <TextView
                android:id="@+id/btnKey6"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="6" />

        </LinearLayout>

        <!-- Row 3: 7 8 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnKey7"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="7" />

            <TextView
                android:id="@+id/btnKey8"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="8" />

            <TextView
                android:id="@+id/btnKey9"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="9" />

        </LinearLayout>

        <!-- Row 4: (trống) 0 xoá -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Space
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnKey0"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="0" />

            <ImageView
                android:id="@+id/btnKeyDelete"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:background="@drawable/bg_numpad_key"
                android:contentDescription="Xoá"
                android:padding="20dp"
                android:src="@drawable/ic_clear" />

        </LinearLayout>

    </LinearLayout>

    <include
        android:id="@+id/btnVerify"
        layout="@layout/layout_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>
