<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        tools:text="@string/pin_enter_new"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- PIN dot indicators -->
    <LinearLayout
        android:id="@+id/llPinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvInstruction">

        <View
            android:id="@+id/vPin1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/vPin2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/vPin3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/vPin4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/vPin5"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/vPin6"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llPinDots" />

    <!-- Numpad: 4 hàng x 3 cột dùng LinearLayout -->
    <LinearLayout
        android:id="@+id/llNumpad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvError">

        <!-- Row 1: 1 2 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnKey1"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="1"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/btnKey2"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="2"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/btnKey3"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="3"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- Row 2: 4 5 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnKey4"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="4"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/btnKey5"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="5"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/btnKey6"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="6"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- Row 3: 7 8 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnKey7"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="7"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/btnKey8"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="8"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/btnKey9"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="9"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- Row 4: (trống) 0 xoá -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Space
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnKey0"
                style="@style/PinNumpadKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="0"
                tools:ignore="HardcodedText" />

            <ImageView
                android:id="@+id/btnKeyDelete"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:background="@drawable/bg_numpad_key"
                android:contentDescription="@string/pin_key_delete_desc"
                android:padding="22dp"
                android:src="@drawable/ic_clear" />

        </LinearLayout>

    </LinearLayout>

    <include
        android:id="@+id/btnNext"
        layout="@layout/layout_action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
