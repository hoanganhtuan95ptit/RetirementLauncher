    <string name="file_permission_title">Protection du Stockage</string>
    <string name="file_permission_desc">Pour que la suppression automatique des fichiers APK/AAB inconnus fonctionne, l\'application a besoin d\'un accès à tout le stockage. Cela aide à garder votre appareil propre et sûr.</string>
    <string name="file_permission_highlight">APK/AAB inconnus</string>
    <string name="usage_stats_permission_title">Surveillance des applications</string>
    <string name="usage_stats_permission_desc">Pour que la fonction de blocage d\'applications fonctionne, vous devez accorder l\'accès aux données d\'utilisation. Cela aide l\'application à savoir quand une application non autorisée est ouverte.</string>
    <string name="usage_stats_permission_highlight">l\'accès aux données d\'utilisation</string>
    <string name="accessibility_permission_title">Détection de l\'activité de l\'utilisateur</string>
    <string name="accessibility_permission_desc">SOS utilise l\'Accessibilité uniquement pour détecter quand l\'utilisateur commence à toucher l\'écran. Il ne lit pas le contenu de l\'écran, n\'enregistre pas de texte, ne modifie pas les paramètres, ne contrôle pas le téléphone et ne partage pas ces données. L\'horodatage de l\'activité reste sur cet appareil et n\'est utilisé que pour décider si SOS doit appeler les contacts d\'urgence.</string>
    <string name="accessibility_permission_highlight">ne lit pas le contenu de l\'écran</string>
    <string name="user_activity_accessibility_service_label">Détection d\'activité utilisateur SOS</string>
    <string name="user_activity_accessibility_service_summary">Détecte l\'activité réelle de l\'utilisateur pour les vérifications d\'inactivité SOS.</string>
    <string name="user_activity_accessibility_service_desc">Utilisé uniquement par l\'Auto SOS pour détecter si le téléphone est toujours activement utilisé. Le service écoute uniquement l\'événement système indiquant que l\'utilisateur a commencé à toucher l\'écran, puis enregistre la dernière heure d\'activité sur cet appareil. Il ne lit pas le contenu de l\'écran, ne collecte pas le texte saisi, n\'inspecte pas les autres applications, ne modifie pas les paramètres, n\'effectue pas de gestes, ne clique pas sur les boutons et ne partage pas ces données d\'activité.</string>
    <string name="app_monitoring_intro_title">Présentation de la fonctionnalité</string>
    <string name="app_monitoring_intro_desc">Cette fonctionnalité aide à protéger les utilisateurs en n\'autorisant que l\'exécution des applications sélectionnées. Les autres applications seront bloquées pour éviter les problèmes involontaires.</string>
    <string name="app_monitoring_intro_highlight">n\'autorisant que l\'exécution des applications sélectionnées</string>
    <string name="app_monitoring_intro_action">Je comprends</string>
    <string name="emergency_call_intro_title">Présentation de la fonctionnalité</string>
    <string name="emergency_call_intro_desc">Pour assurer la sécurité, l\'application appellera automatiquement la liste de contacts rapides si aucune interaction de l\'utilisateur n\'est détectée sur le téléphone pendant 10 heures.</string>
    <string name="emergency_call_intro_highlight">appellera automatiquement la liste de contacts rapides</string>
    <string name="emergency_call_intro_action">Je comprends</string>
    <string name="file_cleanup_intro_title">Présentation de la fonctionnalité</string>
    <string name="file_cleanup_intro_desc">Cette fonctionnalité aide à protéger les utilisateurs en supprimant automatiquement les fichiers d\'installation inconnus (APK) téléchargés sur l\'appareil, évitant ainsi l\'installation accidentelle de logiciels malveillants.</string>
    <string name="file_cleanup_intro_highlight">supprimant automatiquement les fichiers d\'installation inconnus (APK)</string>
    <string name="file_cleanup_intro_action">Je comprends</string>
    <string name="call_block_intro_title">Présentation de la fonctionnalité</string>
    <string name="call_block_intro_desc">Cette fonctionnalité aide à protéger les utilisateurs en bloquant automatiquement les appels de numéros inconnus ne figurant pas dans les contacts, évitant ainsi d\'être dérangé par des publicités ou des arnaques.</string>
    <string name="call_block_intro_highlight">bloquant automatiquement les appels de numéros inconnus</string>
    <string name="call_block_intro_action">Je comprends</string>
    <string name="emergency_contact_required_title">Configuration de contact requise</string>
    <string name="emergency_contact_required_desc">Vous n\'avez pas encore configuré votre liste de contacts rapides. Pour que cette fonctionnalité fonctionne, veuillez sélectionner au moins un contact.</string>
    <string name="emergency_contact_required_highlight">sélectionner au moins un contact</string>
    <string name="emergency_contact_required_action">Configurer maintenant</string>
    <string name="overlay_permission_title">Afficher sur d\'autres applications</string>
    <string name="overlay_permission_desc">L\'application a besoin de l\'autorisation \'Afficher sur d\'autres applications\' pour afficher l\'écran de verrouillage lorsqu\'une application bloquée est ouverte.</string>
