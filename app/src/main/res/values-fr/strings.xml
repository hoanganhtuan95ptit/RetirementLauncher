    <!-- File Permission -->
    <string name="file_permission_title">Protection du stockage</string>
    <string name="file_permission_desc">Pour que la suppression automatique des fichiers APK/AAB inconnus fonctionne, l\'application doit avoir accès à l\'ensemble du stockage. Cela aide à garder votre appareil propre et sûr.</string>
    <string name="file_permission_highlight">APK/AAB inconnus</string>

    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">Surveillance des applications</string>
    <string name="usage_stats_permission_desc">Pour que la fonctionnalité de blocage d\'applications fonctionne, vous devez accorder l\'accès aux données d\'utilisation. Cela permet à l\'application de savoir quand une application non autorisée est ouverte.</string>
    <string name="usage_stats_permission_highlight">l\'accès aux données d\'utilisation</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Présentation de la fonctionnalité</string>
    <string name="app_monitoring_intro_desc">Cette fonctionnalité protège les utilisateurs en n\'autorisant que l\'exécution des applications sélectionnées. Les autres applications seront bloquées pour éviter tout problème involontaire.</string>
    <string name="app_monitoring_intro_highlight">n\'autorisant que les applications sélectionnées</string>
    <string name="app_monitoring_intro_action">Je comprends</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Présentation de la fonctionnalité</string>
    <string name="emergency_call_intro_desc">Pour garantir la sécurité, l\'application appellera automatiquement la liste de contacts rapides si aucune interaction de l\'utilisateur n\'est détectée sur le téléphone pendant 10 heures.</string>
    <string name="emergency_call_intro_highlight">appellera automatiquement la liste de contacts rapides</string>
    <string name="emergency_call_intro_action">Je comprends</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Présentation de la fonctionnalité</string>
    <string name="file_cleanup_intro_desc">Cette fonctionnalité aide à protéger les utilisateurs en supprimant automatiquement les fichiers d\'installation (APK) inconnus téléchargés sur l\'appareil, évitant ainsi l\'installation accidentelle de logiciels malveillants.</string>
    <string name="file_cleanup_intro_highlight">supprimant automatiquement les fichiers d\'installation (APK) inconnus</string>
    <string name="file_cleanup_intro_action">Je comprends</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Présentation de la fonctionnalité</string>
    <string name="call_block_intro_desc">Cette fonctionnalité aide à protéger les utilisateurs en bloquant automatiquement les appels de numéros inconnus ne figurant pas dans les contacts, évitant ainsi d\'être dérangé par des publicités ou des arnaques.</string>
    <string name="call_block_intro_highlight">bloquant automatiquement les appels de numéros inconnus</string>
    <string name="call_block_intro_action">Je comprends</string>

