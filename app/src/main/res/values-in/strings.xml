    <!-- File Permission -->
    <string name="file_permission_title">Perlindungan Penyimpanan</string>
    <string name="file_permission_desc">Agar penghapusan otomatis file APK/AAB yang tidak dikenal dapat berfungsi, aplikasi memerlukan akses ke semua penyimpanan. Ini membantu menjaga perangkat Anda tetap bersih dan aman.</string>
    <string name="file_permission_highlight">APK/AAB yang tidak dikenal</string>

    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">Pemantauan Aplikasi</string>
    <string name="usage_stats_permission_desc">Agar fitur pemblokiran aplikasi berfungsi, Anda perlu memberikan \'Akses Data Penggunaan\'. Ini membantu aplikasi mengetahui kapan aplikasi yang tidak sah dibuka.</string>
    <string name="usage_stats_permission_highlight">\'Akses Data Penggunaan\'</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Pengenalan Fitur</string>
    <string name="app_monitoring_intro_desc">Fitur ini membantu melindungi pengguna dengan hanya mengizinkan aplikasi yang dipilih untuk berjalan. Aplikasi lain akan diblokir untuk menghindari masalah yang tidak diinginkan.</string>
    <string name="app_monitoring_intro_highlight">hanya mengizinkan aplikasi yang dipilih</string>
    <string name="app_monitoring_intro_action">Saya mengerti</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Pengenalan Fitur</string>
    <string name="emergency_call_intro_desc">Untuk memastikan keamanan, aplikasi akan secara otomatis menghubungi daftar kontak cepat jika tidak ada interaksi pengguna yang terdeteksi di ponsel selama 10 jam.</string>
    <string name="emergency_call_intro_highlight">secara otomatis menghubungi daftar kontak cepat</string>
    <string name="emergency_call_intro_action">Saya mengerti</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Pengenalan Fitur</string>
    <string name="file_cleanup_intro_desc">Fitur ini membantu melindungi pengguna dengan menghapus file instalasi (APK) tidak dikenal yang diunduh ke perangkat secara otomatis, guna menghindari penginstalan malware yang tidak disengaja.</string>
    <string name="file_cleanup_intro_highlight">menghapus file instalasi (APK) tidak dikenal secara otomatis</string>
    <string name="file_cleanup_intro_action">Saya mengerti</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Pengenalan Fitur</string>
    <string name="call_block_intro_desc">Fitur ini membantu melindungi pengguna dengan memblokir panggilan dari nomor tidak dikenal yang tidak ada di kontak secara otomatis, guna menghindari gangguan iklan atau penipuan.</string>
    <string name="call_block_intro_highlight">memblokir panggilan dari nomor tidak dikenal secara otomatis</string>
    <string name="call_block_intro_action">Saya mengerti</string>

