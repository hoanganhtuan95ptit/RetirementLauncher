    <string name="file_permission_title">Perlindungan Penyimpanan</string>
    <string name="file_permission_desc">Agar penghapusan otomatis file APK/AAB tidak dikenal dapat berfungsi, aplikasi memerlukan akses ke semua penyimpanan. Ini membantu menjaga perangkat Anda tetap bersih dan aman.</string>
    <string name="file_permission_highlight">APK/AAB tidak dikenal</string>
    <string name="usage_stats_permission_title">Pemantauan Aplikasi</string>
    <string name="usage_stats_permission_desc">Agar fitur pemblokiran aplikasi dapat berfungsi, Anda perlu memberikan \'Akses data penggunaan\'. Ini membantu aplikasi mengetahui kapan aplikasi yang tidak sah dibuka.</string>
    <string name="usage_stats_permission_highlight">\'Akses data penggunaan\'</string>
    <string name="accessibility_permission_title">Deteksi Aktivitas Pengguna</string>
    <string name="accessibility_permission_desc">SOS menggunakan Aksesibilitas hanya untuk mendeteksi kapan pengguna mulai menyentuh layar. Ia tidak membaca konten layar, merekam teks, mengubah pengaturan, mengontrol ponsel, atau membagikan data ini. Stempel waktu aktivitas tetap ada di perangkat ini dan hanya digunakan untuk memutuskan apakah SOS harus memanggil kontak darurat.</string>
    <string name="accessibility_permission_highlight">tidak membaca konten layar</string>
    <string name="user_activity_accessibility_service_label">Deteksi Aktivitas Pengguna SOS</string>
    <string name="user_activity_accessibility_service_summary">Mendeteksi aktivitas pengguna nyata untuk pemeriksaan inaktivitas SOS.</string>
    <string name="user_activity_accessibility_service_desc">Hanya digunakan oleh Auto SOS untuk mendeteksi apakah ponsel masih digunakan secara aktif. Layanan hanya mendengarkan peristiwa sistem yang menunjukkan bahwa pengguna telah mulai menyentuh layar, lalu menyimpan waktu aktivitas terbaru di perangkat ini. Ia tidak membaca konten layar, mengumpulkan teks yang diketik, memeriksa aplikasi lain, mengubah pengaturan, melakukan gerakan, mengeklik tombol, atau membagikan data aktivitas ini.</string>
    <string name="app_monitoring_intro_title">Pengenalan Fitur</string>
    <string name="app_monitoring_intro_desc">Fitur ini membantu melindungi pengguna dengan hanya mengizinkan aplikasi terpilih untuk berjalan. Aplikasi lain akan diblokir untuk menghindari masalah yang tidak diinginkan.</string>
    <string name="app_monitoring_intro_highlight">hanya mengizinkan aplikasi terpilih</string>
    <string name="app_monitoring_intro_action">Saya mengerti</string>
    <string name="emergency_call_intro_title">Pengenalan Fitur</string>
    <string name="emergency_call_intro_desc">Untuk memastikan keamanan, aplikasi akan secara otomatis memanggil daftar kontak cepat jika tidak ada interaksi pengguna yang terdeteksi di ponsel selama 10 jam.</string>
    <string name="emergency_call_intro_highlight">secara otomatis memanggil daftar kontak cepat</string>
    <string name="emergency_call_intro_action">Saya mengerti</string>
    <string name="file_cleanup_intro_title">Pengenalan Fitur</string>
    <string name="file_cleanup_intro_desc">Fitur ini membantu melindungi pengguna dengan menghapus secara otomatis file instalasi tidak dikenal (APK) yang diunduh ke perangkat, menghindari penginstalan malware yang tidak disengaja.</string>
    <string name="file_cleanup_intro_highlight">menghapus secara otomatis file instalasi tidak dikenal (APK)</string>
    <string name="file_cleanup_intro_action">Saya mengerti</string>
    <string name="call_block_intro_title">Pengenalan Fitur</string>
    <string name="call_block_intro_desc">Fitur ini membantu melindungi pengguna dengan memblokir secara otomatis panggilan dari nomor tidak dikenal yang tidak ada dalam kontak, menghindari gangguan iklan atau penipuan.</string>
    <string name="call_block_intro_highlight">memblokir secara otomatis panggilan dari nomor tidak dikenal</string>
    <string name="call_block_intro_action">Saya mengerti</string>
    <string name="emergency_contact_required_title">Pengaturan Kontak Diperlukan</string>
    <string name="emergency_contact_required_desc">Anda belum mengatur daftar kontak cepat Anda. Agar fitur ini berfungsi, silakan pilih setidaknya satu kontak.</string>
    <string name="emergency_contact_required_highlight">pilih setidaknya satu kontak</string>
    <string name="emergency_contact_required_action">Atur Sekarang</string>
