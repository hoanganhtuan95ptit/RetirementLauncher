    <!-- File Permission -->
    <string name="file_permission_title">Protezione archiviazione</string>
    <string name="file_permission_desc">Affinché l\'eliminazione automatica dei file APK/AAB sconosciuti funzioni, l\'app deve avere accesso a tutto l\'archivio. Questo aiuta a mantenere il tuo dispositivo pulito e sicuro.</string>
    <string name="file_permission_highlight">APK/AAB sconosciuti</string>

    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">Monitoraggio app</string>
    <string name="usage_stats_permission_desc">Affinché la funzione di blocco delle app funzioni, è necessario concedere l\'\'Accesso ai dati di utilizzo\'. Questo aiuta l\'app a sapere quando viene aperta un\'app non autorizzata.</string>
    <string name="usage_stats_permission_highlight">\'Accesso ai dati di utilizzo\'</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Introduzione alla funzione</string>
    <string name="app_monitoring_intro_desc">Questa funzione protegge gli utenti consentendo l\'esecuzione solo delle app selezionate. Le altre app verranno bloccate per evitare problemi imprevisti.</string>
    <string name="app_monitoring_intro_highlight">consentendo solo le app selezionate</string>
    <string name="app_monitoring_intro_action">Ho capito</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Introduzione alla funzione</string>
    <string name="emergency_call_intro_desc">Per garantire la sicurezza, l\'app chiamerà automaticamente l\'elenco dei contatti rapidi se non viene rilevata alcuna interazione dell\'utente sul telefono per 10 ore.</string>
    <string name="emergency_call_intro_highlight">chiamerà automaticamente l\'elenco dei contatti rapidi</string>
    <string name="emergency_call_intro_action">Ho capito</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Introduzione alla funzione</string>
    <string name="file_cleanup_intro_desc">Questa funzione protegge gli utenti eliminando automaticamente i file di installazione (APK) sconosciuti scaricati sul dispositivo, evitando l\'installazione accidentale di malware.</string>
    <string name="file_cleanup_intro_highlight">eliminando automaticamente i file di installazione (APK) sconosciuti</string>
    <string name="file_cleanup_intro_action">Ho capito</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Introduzione alla funzione</string>
    <string name="call_block_intro_desc">Questa funzione protegge gli utenti bloccando automaticamente le chiamate da numeri sconosciuti non presenti nei contatti, evitando fastidi dovuti a pubblicità o truffe.</string>
    <string name="call_block_intro_highlight">bloccando automaticamente le chiamate da numeri sconosciuti</string>
    <string name="call_block_intro_action">Ho capito</string>

