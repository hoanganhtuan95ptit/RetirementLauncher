    <!-- Call Permission -->
    <string name="call_permission_title">Дозвіл на дзвінки</string>
    <string name="call_permission_desc">Програмі потрібен дозвіл на здійснення дзвінків, щоб автоматично викликати родичів у екстрених ситуаціях.</string>
