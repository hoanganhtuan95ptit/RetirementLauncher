    <!-- File Permission -->
    <string name="file_permission_title">Захист сховища</string>
    <string name="file_permission_desc">Для роботи функції автоматичного видалення невідомих файлів APK/AAB програмі потрібен доступ до всього сховища. Це допомагає підтримувати ваш пристрій чистим та безпечним.</string>
    <string name="file_permission_highlight">невідомих APK/AAB</string>

    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">Моніторинг програм</string>
    <string name="usage_stats_permission_desc">Для роботи функції блокування програм необхідно надати «Доступ до даних про використання». Це допомагає програмі знати, коли відкривається неавторизована програма.</string>
    <string name="usage_stats_permission_highlight">«Доступ до даних про використання»</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Про функцію</string>
    <string name="app_monitoring_intro_desc">Ця функція захищає користувачів, дозволяючи запуск лише вибраних програм. Інші програми будуть блокуватися, щоб уникнути ненавмисних проблем.</string>
    <string name="app_monitoring_intro_highlight">дозволяючи запуск лише вибраних програм</string>
    <string name="app_monitoring_intro_action">Я розумію</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Про функцію</string>
    <string name="emergency_call_intro_desc">Для забезпечення безпеки програма автоматично зателефонує за списком швидких контактів, якщо протягом 10 годин на телефоні не буде виявлено жодної активності користувача.</string>
    <string name="emergency_call_intro_highlight">автоматично зателефонує за списком швидких контактів</string>
    <string name="emergency_call_intro_action">Я розумію</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Про функцію</string>
    <string name="file_cleanup_intro_desc">Ця функція захищає користувачів, автоматично видаляючи невідомі інсталяційні файли (APK), завантажені на пристрій, що запобігає випадковому встановленню шкідливого ПЗ.</string>
    <string name="file_cleanup_intro_highlight">автоматично видаляючи невідомі інсталяційні файли (APK)</string>
    <string name="file_cleanup_intro_action">Я розумію</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Про функцію</string>
    <string name="call_block_intro_desc">Ця функція захищає користувачів, автоматично блокуючи дзвінки з невідомих номерів, яких немає в контактах, допомагаючи уникнути реклами та шахраїв.</string>
    <string name="call_block_intro_highlight">автоматично блокуючи дзвінки з невідомих номерів</string>
    <string name="call_block_intro_action">Я розумію</string>

    <!-- Overlay Permission -->
    <string name="overlay_permission_title">Відображення поверх інших програм</string>
    <string name="overlay_permission_desc">Програмі потрібен дозвіл «Відображення поверх інших програм», щоб показувати екран блокування при відкритті заблокованої програми.</string>
    <string name="overlay_permission_highlight">«Відображення поверх інших програм»</string>
