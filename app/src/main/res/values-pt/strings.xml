    <!-- File Permission -->
    <string name="file_permission_title">Proteção de Armazenamento</string>
    <string name="file_permission_desc">Para que a exclusão automática de arquivos APK/AAB desconhecidos funcione, o app precisa de acesso a todo o armazenamento. Isso ajuda a manter o seu dispositivo limpo e seguro.</string>
    <string name="file_permission_highlight">APK/AAB desconhecidos</string>

    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">Monitoramento de Apps</string>
    <string name="usage_stats_permission_desc">Para que o recurso de bloqueio de apps funcione, você precisa conceder \'Acesso aos Dados de Uso\'. Isso ajuda o app a saber quando um app não autorizado é aberto.</string>
    <string name="usage_stats_permission_highlight">\'Acesso aos Dados de Uso\'</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Introdução ao Recurso</string>
    <string name="app_monitoring_intro_desc">Este recurso ajuda a proteger os usuários permitindo que apenas os apps selecionados sejam executados. Outros apps serão bloqueados para evitar problemas indesejados.</string>
    <string name="app_monitoring_intro_highlight">permitindo apenas apps selecionados</string>
    <string name="app_monitoring_intro_action">Eu entendo</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Introdução ao Recurso</string>
    <string name="emergency_call_intro_desc">Para garantir a segurança, o app ligará automaticamente para a lista de contatos rápidos se nenhuma interação do usuário for detectada no telefone por 10 horas.</string>
    <string name="emergency_call_intro_highlight">ligará automaticamente para a lista de contatos rápidos</string>
    <string name="emergency_call_intro_action">Eu entendo</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Introdução ao Recurso</string>
    <string name="file_cleanup_intro_desc">Este recurso ajuda a proteger os usuários excluindo automaticamente arquivos de instalação (APK) desconhecidos baixados para o dispositivo, evitando a instalação acidental de malware.</string>
    <string name="file_cleanup_intro_highlight">excluindo automaticamente arquivos de instalação (APK) desconhecidos</string>
    <string name="file_cleanup_intro_action">Eu entendo</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Introdução ao Recurso</string>
    <string name="call_block_intro_desc">Este recurso ajuda a proteger os usuários bloqueando automaticamente chamadas de números desconhecidos que não estão nos contatos, evitando incômodos com anúncios ou golpes.</string>
    <string name="call_block_intro_highlight">bloqueando automaticamente chamadas de números desconhecidos</string>
    <string name="call_block_intro_action">Eu entendo</string>

