    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">Alkalmazásfigyelés</string>
    <string name="usage_stats_permission_desc">Az alkalmazásblokkoló funkció működéséhez meg kell adnia a „Használati adatokhoz való hozzáférés” engedélyt. Ez segít az alkalmazásnak felismerni, ha egy nem engedélyezett alkalmazást nyitnak meg.</string>
    <string name="usage_stats_permission_highlight">„Használati adatokhoz való hozzáférés”</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Funkció bemutatása</string>
    <string name="app_monitoring_intro_desc">Ez a funkció védi a felhasználókat azáltal, hogy csak a kiválasztott alkalmazások futtatását teszi lehetővé. A nem kívánt problémák elkerülése érdekében a többi alkalmazás blokkolva lesz.</string>
    <string name="app_monitoring_intro_highlight">csak a kiválasztott alkalmazások engedélyezése</string>
    <string name="app_monitoring_intro_action">Értem</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Funkció bemutatása</string>
    <string name="emergency_call_intro_desc">A biztonság érdekében az alkalmazás automatikusan hívja a gyorstárcsázási névjegyzéket, ha 10 órán keresztül nem észlelhető felhasználói interakció a telefonon.</string>
    <string name="emergency_call_intro_highlight">automatikusan hívja a gyorstárcsázási névjegyzéket</string>
    <string name="emergency_call_intro_action">Értem</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Funkció bemutatása</string>
    <string name="file_cleanup_intro_desc">Ez a funkció védi a felhasználókat azáltal, hogy automatikusan törli a készülékre letöltött ismeretlen telepítőfájlokat (APK), elkerülve a rosszindulatú programok véletlen telepítését.</string>
    <string name="file_cleanup_intro_highlight">ismeretlen telepítőfájlok (APK) automatikus törlése</string>
    <string name="file_cleanup_intro_action">Értem</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Funkció bemutatása</string>
    <string name="call_block_intro_desc">Ez a funkció védi a felhasználókat azáltal, hogy automatikusan blokkolja a névjegyzékben nem szereplő ismeretlen számokról érkező hívásokat, elkerülve a reklámok vagy csalások miatti kellemetlenségeket.</string>
    <string name="call_block_intro_highlight">ismeretlen számokról érkező hívások automatikus blokkolása</string>
    <string name="call_block_intro_action">Értem</string>

