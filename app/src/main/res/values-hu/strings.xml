    <string name="file_permission_title">Tárhelyvédelem</string>
    <string name="file_permission_desc">Az ismeretlen APK/AAB fájlok automatikus törlésének működéséhez az alkalmazásnak hozzá kell férnie a teljes tárhelyhez. Ez segít tisztán és biztonságban tartani a készüléket.</string>
    <string name="file_permission_highlight">ismeretlen APK/AAB</string>
    <string name="usage_stats_permission_title">Alkalmazásfigyelés</string>
    <string name="usage_stats_permission_desc">Az alkalmazásblokkoló funkció működéséhez engedélyeznie kell a „Használati adatokhoz való hozzáférést”. Ez segít az alkalmazásnak felismerni, ha egy nem engedélyezett alkalmazást nyitnak meg.</string>
    <string name="usage_stats_permission_highlight">„Használati adatokhoz való hozzáférés”</string>
    <string name="accessibility_permission_title">Felhasználói tevékenység észlelése</string>
    <string name="accessibility_permission_desc">Az SOS a Kisegítő lehetőségeket csak annak észlelésére használja, hogy a felhasználó mikor kezdi megérinteni a képernyőt. Nem olvassa a képernyő tartalmát, nem rögzít szöveget, nem módosítja a beállításokat, nem vezérli a telefont, és nem osztja meg ezeket az adatokat. A tevékenység időbélyege ezen az eszközön marad, és csak annak eldöntésére szolgál, hogy az SOS-nek hívnia kell-e a segélyhívó kapcsolatokat.</string>
    <string name="accessibility_permission_highlight">nem olvassa a képernyő tartalmát</string>
    <string name="user_activity_accessibility_service_label">SOS Felhasználói tevékenység észlelése</string>
    <string name="user_activity_accessibility_service_summary">Valódi felhasználói tevékenységet észlel az SOS inaktivitási ellenőrzéseihez.</string>
    <string name="user_activity_accessibility_service_desc">Csak az Auto SOS használja annak észlelésére, hogy a telefont még mindig aktívan használják-e. A szolgáltatás csak azt a rendszereseményt figyeli, amely azt jelzi, hogy a felhasználó elkezdte megérinteni a képernyőt, majd elmenti a legutóbbi tevékenység idejét ezen az eszközön. Nem olvassa a képernyő tartalmát, nem gyűjt beírt szöveget, nem vizsgál más alkalmazásokat, nem módosítja a beállításokat, nem hajt végre gesztusokat, nem kattint gombokra, és nem osztja meg ezeket a tevékenységi adatokat.</string>
    <string name="app_monitoring_intro_title">Funkció bemutatása</string>
    <string name="app_monitoring_intro_desc">Ez a funkció segít megvédeni a felhasználókat azáltal, hogy csak a kiválasztott alkalmazások futtatását teszi lehetővé. Más alkalmazások blokkolva lesznek a nem kívánt problémák elkerülése érdekében.</string>
    <string name="app_monitoring_intro_highlight">csak a kiválasztott alkalmazások futtatását teszi lehetővé</string>
    <string name="app_monitoring_intro_action">Értem</string>
    <string name="emergency_call_intro_title">Funkció bemutatása</string>
    <string name="emergency_call_intro_desc">A biztonság garantálása érdekében az alkalmazás automatikusan hívja a gyors kapcsolatok listáját, ha 10 órán keresztül nem észlelhető felhasználói interakció a telefonon.</string>
    <string name="emergency_call_intro_highlight">automatikusan hívja a gyors kapcsolatok listáját</string>
    <string name="emergency_call_intro_action">Értem</string>
    <string name="file_cleanup_intro_title">Funkció bemutatása</string>
    <string name="file_cleanup_intro_desc">Ez a funkció segít megvédeni a felhasználókat azáltal, hogy automatikusan törli a készülékre letöltött ismeretlen telepítőfájlokat (APK), elkerülve a rosszindulatú programok véletlen telepítését.</string>
    <string name="file_cleanup_intro_highlight">automatikusan törli az ismeretlen telepítőfájlokat (APK)</string>
    <string name="file_cleanup_intro_action">Értem</string>
    <string name="call_block_intro_title">Funkció bemutatása</string>
    <string name="call_block_intro_desc">Ez a funkció segít megvédeni a felhasználókat azáltal, hogy automatikusan blokkolja a névjegyzékben nem szereplő ismeretlen számokról érkező hívásokat, elkerülve a reklámok vagy csalások okozta kellemetlenségeket.</string>
    <string name="call_block_intro_highlight">automatikusan blokkolja az ismeretlen számokról érkező hívásokat</string>
    <string name="call_block_intro_action">Értem</string>
    <string name="emergency_contact_required_title">Kapcsolat beállítása szükséges</string>
    <string name="emergency_contact_required_desc">Még nem állította be a gyors kapcsolatok listáját. A funkció működéséhez válasszon ki legalább egy névjegyet.</string>
