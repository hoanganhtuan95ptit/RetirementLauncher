    <!-- File Permission -->
    <string name="file_permission_title">Tárhelyvédelem</string>
    <string name="file_permission_desc">Az ismeretlen APK/AAB fájlok automatikus törlésének működéséhez az alkalmazásnak hozzá kell férnie a teljes tárhelyhez. Ez segít tisztán és biztonságban tartani a készüléket.</string>
