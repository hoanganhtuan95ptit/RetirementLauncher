    <string name="default_launcher_title">Thiết lập Launcher mặc định</string>
    <string name="default_launcher_desc">Để sử dụng Retirement Launcher làm màn hình chính, bạn cần thiết lập nó làm ứng dụng mặc định trong cài đặt hệ thống.</string>
