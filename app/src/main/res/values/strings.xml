    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Feature Introduction</string>
    <string name="app_monitoring_intro_desc">This feature helps protect users by only allowing selected apps to run. Other apps will be blocked to avoid unintended issues.</string>
    <string name="app_monitoring_intro_highlight">only allowing selected apps</string>
    <string name="app_monitoring_intro_action">I understand</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Feature Introduction</string>
    <string name="emergency_call_intro_desc">To ensure safety, the app will automatically call the quick contact list if no user interaction is detected on the phone for 10 hours.</string>
    <string name="emergency_call_intro_highlight">automatically call the quick contact list</string>
    <string name="emergency_call_intro_action">I understand</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Feature Introduction</string>
    <string name="file_cleanup_intro_desc">This feature helps protect users by automatically deleting unknown installation files (APK) downloaded to the device, avoiding accidental installation of malware.</string>
    <string name="file_cleanup_intro_highlight">automatically deleting unknown installation files (APK)</string>
    <string name="file_cleanup_intro_action">I understand</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Feature Introduction</string>
    <string name="call_block_intro_desc">This feature helps protect users by automatically blocking calls from unknown numbers not in the contacts, avoiding being bothered by ads or scams.</string>
    <string name="call_block_intro_highlight">automatically blocking calls from unknown numbers</string>
    <string name="call_block_intro_action">I understand</string>

