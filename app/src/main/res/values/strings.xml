    <string name="pin_key_delete_desc">Xoá</string>

    <!-- File Permission -->
    <string name="file_permission_title">Bảo vệ bộ nhớ</string>
    <string name="file_permission_desc">Để tính năng tự động xóa các file APK/AAB lạ hoạt động, ứng dụng cần quyền truy cập tất cả bộ nhớ. Điều này giúp thiết bị của bạn luôn sạch sẽ và an toàn.</string>
    <string name="file_permission_highlight">APK/AAB lạ</string>

    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">Giám sát ứng dụng</string>
    <string name="usage_stats_permission_desc">Để tính năng chặn ứng dụng hoạt động, bạn cần cấp quyền \'Truy cập dữ liệu sử dụng\'. Điều này giúp ứng dụng biết khi nào một ứng dụng không được phép được mở.</string>
    <string name="usage_stats_permission_highlight">\'Truy cập dữ liệu sử dụng\'</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Giới thiệu tính năng</string>
    <string name="app_monitoring_intro_desc">Tính năng này giúp bảo vệ người dùng bằng cách chỉ cho phép các ứng dụng đã được chọn hoạt động. Các ứng dụng khác sẽ bị chặn để tránh sự cố không mong muốn.</string>
    <string name="app_monitoring_intro_highlight">chỉ cho phép các ứng dụng đã được chọn</string>
    <string name="app_monitoring_intro_action">Tôi đã hiểu</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Giới thiệu tính năng</string>
    <string name="emergency_call_intro_desc">Để đảm bảo an toàn, ứng dụng sẽ tự động gọi cho danh sách liên hệ nhanh nếu sau 10 giờ không thấy người dùng thao tác gì trên điện thoại.</string>
    <string name="emergency_call_intro_highlight">tự động gọi cho danh sách liên hệ nhanh</string>
    <string name="emergency_call_intro_action">Tôi đã hiểu</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Giới thiệu tính năng</string>
    <string name="file_cleanup_intro_desc">Tính năng này giúp bảo vệ người dùng bằng cách tự động xóa các file cài đặt (APK) lạ được tải về máy, tránh việc cài đặt nhầm mã độc.</string>
    <string name="file_cleanup_intro_highlight">tự động xóa các file cài đặt (APK) lạ</string>
    <string name="file_cleanup_intro_action">Tôi đã hiểu</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Giới thiệu tính năng</string>
    <string name="call_block_intro_desc">Tính năng này giúp bảo vệ người dùng bằng cách tự động chặn các cuộc gọi từ số lạ không có trong danh bạ, tránh bị làm phiền bởi quảng cáo hoặc lừa đảo.</string>
    <string name="call_block_intro_highlight">tự động chặn các cuộc gọi từ số lạ</string>
    <string name="call_block_intro_action">Tôi đã hiểu</string>

    <!-- Overlay Permission -->
    <string name="overlay_permission_title">Hiển thị trên ứng dụng khác</string>
    <string name="overlay_permission_desc">Ứng dụng cần quyền \'Hiển thị trên các ứng dụng khác\' để có thể hiển thị màn hình khóa khi một ứng dụng bị chặn được mở.</string>
    <string name="overlay_permission_highlight">\'Hiển thị trên các ứng dụng khác\'</string>
