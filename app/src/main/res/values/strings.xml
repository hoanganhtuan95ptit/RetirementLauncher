    <!-- File Permission -->
    <string name="file_permission_title">Storage Protection</string>
    <string name="file_permission_desc">For the automatic deletion of unknown APK/AAB files to work, the app needs access to all storage. This helps keep your device clean and safe.</string>
    <string name="file_permission_highlight">unknown APK/AAB</string>

    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">App Monitoring</string>
    <string name="usage_stats_permission_desc">For the app blocking feature to work, you need to grant \'Usage Data Access\'. This helps the app know when an unauthorized app is opened.</string>
    <string name="usage_stats_permission_highlight">\'Usage Data Access\'</string>

    <!-- Accessibility Permission -->
    <string name="accessibility_permission_title">User Activity Detection</string>
    <string name="accessibility_permission_desc">SOS uses Accessibility only to detect when the user starts touching the screen. It does not read screen content, record text, change settings, control the phone, or share this data. The activity timestamp stays on this device and is used only to decide whether SOS should call emergency contacts.</string>
    <string name="accessibility_permission_highlight">does not read screen content</string>
    <string name="user_activity_accessibility_service_label">SOS User Activity Detection</string>
    <string name="user_activity_accessibility_service_summary">Detects real user activity for SOS inactivity checks.</string>
    <string name="user_activity_accessibility_service_desc">Used only by Auto SOS to detect whether the phone is still being actively used. The service listens only for the system event that indicates the user has started touching the screen, then saves the latest activity time on this device. It does not read screen content, collect typed text, inspect other apps, change settings, perform gestures, click buttons, or share this activity data.</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Feature Introduction</string>
    <string name="app_monitoring_intro_desc">This feature helps protect users by only allowing selected apps to run. Other apps will be blocked to avoid unintended issues.</string>
    <string name="app_monitoring_intro_highlight">only allowing selected apps</string>
    <string name="app_monitoring_intro_action">I understand</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Feature Introduction</string>
    <string name="emergency_call_intro_desc">To ensure safety, the app will automatically call the quick contact list if no user interaction is detected on the phone for 10 hours.</string>
    <string name="emergency_call_intro_highlight">automatically call the quick contact list</string>
    <string name="emergency_call_intro_action">I understand</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Feature Introduction</string>
    <string name="file_cleanup_intro_desc">This feature helps protect users by automatically deleting unknown installation files (APK) downloaded to the device, avoiding accidental installation of malware.</string>
    <string name="file_cleanup_intro_highlight">automatically deleting unknown installation files (APK)</string>
    <string name="file_cleanup_intro_action">I understand</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Feature Introduction</string>
    <string name="call_block_intro_desc">This feature helps protect users by automatically blocking calls from unknown numbers not in the contacts, avoiding being bothered by ads or scams.</string>
    <string name="call_block_intro_highlight">automatically blocking calls from unknown numbers</string>
    <string name="call_block_intro_action">I understand</string>

