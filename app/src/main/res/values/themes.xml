<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.RetirementLauncher" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary -->
        <item name="colorPrimary">#58C27D</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#DDF5E5</item>
        <item name="colorOnPrimaryContainer">#1E4D2B</item>

        <!-- Secondary -->
        <item name="colorSecondary">#8E8E93</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#F1F1F4</item>
        <item name="colorOnSecondaryContainer">#3A3A3C</item>

        <!-- Tertiary -->
        <item name="colorTertiary">#6C63FF</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#E9E7FF</item>
        <item name="colorOnTertiaryContainer">#2E2787</item>

        <!-- Error -->
        <item name="colorError">#FF5C5C</item>
        <item name="colorOnError">#FFFFFF</item>

        <!-- Background -->
        <item name="android:colorBackground">#F5F5F7</item>
        <item name="colorOnBackground">#1C1C1E</item>

        <!-- Surface -->
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1C1C1E</item>

        <!-- Surface Variant -->
        <item name="colorSurfaceVariant">#F1F1F4</item>
        <item name="colorOnSurfaceVariant">#8E8E93</item>

        <!-- Outline -->
        <item name="colorOutline">#D1D1D6</item>

        <!-- Home stat card backgrounds -->
        <item name="colorCleanFilesStatCardBgActive">#FBC4C4</item>
        <item name="colorCleanFilesStatCardOnBgActive">#FF4950</item>
        <item name="colorCleanFilesStatCardBgIdle">#6AC674</item>
        <item name="colorCleanFilesStatCardOnBgIdle">#FFFFFF</item>

        <item name="colorCleanMemoryStatCardBgActive">#FBC4C4</item>
        <item name="colorCleanMemoryStatCardOnBgActive">#FF4950</item>
        <item name="colorCleanMemoryStatCardBgIdle">#6281F0</item>
        <item name="colorCleanMemoryStatCardOnBgIdle">#FFFFFF</item>

        <!-- Inverse -->
<!--        <item name="colorInverseSurface">#1C1C1E</item>-->
<!--        <item name="colorInverseOnSurface">#FFFFFF</item>-->
        <item name="colorPrimaryInverse">#3DAA63</item>
    </style>

    <style name="Theme.RetirementLauncher.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

    <style name="BaseBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BaseBottomSheetStyle</item>
    </style>

    <style name="BaseBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

</resources>