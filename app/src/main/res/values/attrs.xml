<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="WindowInsetsFrameLayout">
        <attr name="insetStatusBars" format="boolean" />
        <attr name="insetNavigationBars" format="boolean" />
    </declare-styleable>

    <declare-styleable name="SpaceWindowInsetsView">
        <attr name="applyStatusBars" format="boolean" />
        <attr name="applyNavigationBars" format="boolean" />
    </declare-styleable>

    <!-- Home stat card backgrounds -->
    <attr name="colorCleanFilesStatCardBgActive" format="color" />
    <attr name="colorCleanFilesStatCardOnBgActive" format="color" />
    <attr name="colorCleanFilesStatCardBgIdle" format="color" />
    <attr name="colorCleanFilesStatCardOnBgIdle" format="color" />

    <attr name="colorCleanMemoryStatCardBgActive" format="color" />
    <attr name="colorCleanMemoryStatCardOnBgActive" format="color" />
    <attr name="colorCleanMemoryStatCardBgIdle" format="color" />
    <attr name="colorCleanMemoryStatCardOnBgIdle" format="color" />

    <declare-styleable name="OutlineView">
        <attr name="ov_strokeColor" format="color" />
        <attr name="ov_strokeWidth" format="dimension" />
        <attr name="ov_cornerRadius" format="dimension" />
        <attr name="ov_dashWidth" format="dimension" />
        <attr name="ov_dashGap" format="dimension" />
        <attr name="ov_loading" format="boolean" />
        <attr name="ov_show" format="boolean" />
        <attr name="ov_loadingSegmentRatio" format="float" />
        <attr name="ov_loadingDuration" format="integer" />
    </declare-styleable>
</resources>
