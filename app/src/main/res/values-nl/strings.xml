    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Introductie van de functie</string>
    <string name="app_monitoring_intro_desc">Deze functie beschermt gebruikers door alleen geselecteerde apps toe te staan. Andere apps worden geblokkeerd om onbedoelde problemen te voorkomen.</string>
