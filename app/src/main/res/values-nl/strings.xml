    <string name="app_monitoring_intro_action">Ik begrijp het</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Introductie van de functie</string>
    <string name="emergency_call_intro_desc">Om de veiligheid te garanderen, belt de app automatisch de lijst met snelcontacten als er gedurende 10 uur geen gebruikersinteractie op de telefoon wordt gedetecteerd.</string>
    <string name="emergency_call_intro_highlight">automatisch de lijst met snelcontacten bellen</string>
    <string name="emergency_call_intro_action">Ik begrijp het</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Introductie van de functie</string>
    <string name="file_cleanup_intro_desc">Deze functie beschermt gebruikers door onbekende installatiebestanden (APK) die naar het apparaat zijn gedownload automatisch te verwijderen, om onbedoelde installatie van malware te voorkomen.</string>
    <string name="file_cleanup_intro_highlight">automatisch onbekende installatiebestanden (APK) verwijderen</string>
    <string name="file_cleanup_intro_action">Ik begrijp het</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Introductie van de functie</string>
    <string name="call_block_intro_desc">Deze functie beschermt gebruikers door automatisch oproepen van onbekende nummers die niet in de contacten staan te blokkeren, om overlast door advertenties of oplichting te voorkomen.</string>
    <string name="call_block_intro_highlight">automatisch oproepen van onbekende nummers blokkeren</string>
    <string name="call_block_intro_action">Ik begrijp het</string>

