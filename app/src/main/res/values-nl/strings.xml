    <string name="file_permission_title">Opslagbeveiliging</string>
    <string name="file_permission_desc">Om de automatische verwijdering van onbekende APK/AAB-bestanden te laten werken, heeft de app toegang tot alle opslagruimte nodig. Dit helpt om uw apparaat schoon en veilig te houden.</string>
    <string name="file_permission_highlight">onbekende APK/AAB</string>
    <string name="usage_stats_permission_title">App-monitoring</string>
    <string name="usage_stats_permission_desc">Om de app-blokkeerfunctie te laten werken, moet u \'Toegang tot gebruiksgegevens\' verlenen. Dit helpt de app te weten wanneer een niet-geautoriseerde app wordt geopend.</string>
    <string name="usage_stats_permission_highlight">\'Toegang tot gebruiksgegevens\'</string>
    <string name="accessibility_permission_title">Detectie van gebruikersactiviteit</string>
    <string name="accessibility_permission_desc">SOS gebruikt Toegankelijkheid alleen om te detecteren wanneer de gebruiker het scherm begint aan te raken. Het leest geen scherminhoud, neemt geen tekst op, wijzigt geen instellingen, bedient de telefoon niet en deelt deze gegevens niet. Het tijdstempel van de activiteit blijft op dit apparaat en wordt alleen gebruikt om te beslissen of SOS noodcontacten moet bellen.</string>
    <string name="accessibility_permission_highlight">leest geen scherminhoud</string>
    <string name="user_activity_accessibility_service_label">Detectie van SOS-gebruikersactiviteit</string>
    <string name="user_activity_accessibility_service_summary">Detecteert echte gebruikersactiviteit voor SOS-inactiviteitscontroles.</string>
    <string name="user_activity_accessibility_service_desc">Alleen gebruikt door Auto SOS om te detecteren of de telefoon nog actief wordt gebruikt. De service luistert alleen naar de systeemgebeurtenis die aangeeft dat de gebruiker het scherm is gaan aanraken en slaat vervolgens de laatste activiteitstijd op dit apparaat op. Het leest geen scherminhoud, verzamelt geen getypte tekst, inspecteert geen andere apps, wijzigt geen instellingen, voert geen gebaren uit, klikt niet op knoppen en deelt deze activiteitsgegevens niet.</string>
    <string name="app_monitoring_intro_title">Introductie functie</string>
    <string name="app_monitoring_intro_desc">Deze functie helpt gebruikers te beschermen door alleen geselecteerde apps toe te staan. Andere apps worden geblokkeerd om onbedoelde problemen te voorkomen.</string>
    <string name="app_monitoring_intro_highlight">alleen geselecteerde apps toe te staan</string>
    <string name="app_monitoring_intro_action">Ik begrijp het</string>
    <string name="emergency_call_intro_title">Introductie functie</string>
    <string name="emergency_call_intro_desc">Om de veiligheid te garanderen, belt de app automatisch de snelcontactlijst als er gedurende 10 uur geen gebruikersinteractie op de telefoon wordt gedetecteerd.</string>
    <string name="emergency_call_intro_highlight">belt automatisch de snelcontactlijst</string>
    <string name="emergency_call_intro_action">Ik begrijp het</string>
    <string name="file_cleanup_intro_title">Introductie functie</string>
    <string name="file_cleanup_intro_desc">Deze functie helpt gebruikers te beschermen door automatisch onbekende installatiebestanden (APK) te verwijderen die naar het apparaat zijn gedownload, waardoor onbedoelde installatie van malware wordt voorkomen.</string>
    <string name="file_cleanup_intro_highlight">automatisch onbekende installatiebestanden (APK) te verwijderen</string>
    <string name="file_cleanup_intro_action">Ik begrijp het</string>
    <string name="call_block_intro_title">Introductie functie</string>
    <string name="call_block_intro_desc">Deze functie helpt gebruikers te beschermen door automatisch oproepen te blokkeren van onbekende nummers die niet in de contacten staan, waardoor overlast door advertenties of oplichting wordt voorkomen.</string>
    <string name="call_block_intro_highlight">automatisch oproepen te blokkeren van onbekende nummers</string>
    <string name="call_block_intro_action">Ik begrijp het</string>
    <string name="emergency_contact_required_title">Contact instellen vereist</string>
    <string name="emergency_contact_required_desc">U heeft uw snelcontactlijst nog niet ingesteld. Om deze functie te laten werken, selecteert u ten minste één contact.</string>
    <string name="emergency_contact_required_highlight">selecteert u ten minste één contact</string>
    <string name="emergency_contact_required_action">Nu instellen</string>
    <string name="overlay_permission_title">Weergeven boven andere apps</string>
    <string name="overlay_permission_desc">De app heeft de toestemming \'Weergeven boven andere apps\' nodig om het vergrendelscherm te tonen wanneer een geblokkeerde app wordt geopend.</string>
    <string name="overlay_permission_highlight">\'Weergeven boven andere apps\'</string>
