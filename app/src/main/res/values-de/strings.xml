    <!-- File Permission -->
    <string name="file_permission_title">Speicherschutz</string>
    <string name="file_permission_desc">Damit das automatische Löschen unbekannter APK/AAB-Dateien funktioniert, benötigt die App Zugriff auf den gesamten Speicher. Dies hilft, Ihr Gerät sauber und sicher zu halten.</string>
    <string name="file_permission_highlight">unbekannte APK/AAB</string>

    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">App-Überwachung</string>
    <string name="usage_stats_permission_desc">Damit die App-Blockierungsfunktion funktioniert, müssen Sie den „Zugriff auf Nutzungsdaten“ gewähren. Dies hilft der App zu erkennen, wenn eine nicht autorisierte App geöffnet wird.</string>
    <string name="usage_stats_permission_highlight">„Zugriff auf Nutzungsdaten“</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Funktionseinführung</string>
    <string name="app_monitoring_intro_desc">Diese Funktion schützt Benutzer, indem sie nur die Ausführung ausgewählter Apps zulässt. Andere Apps werden blockiert, um unbeabsichtigte Probleme zu vermeiden.</string>
    <string name="app_monitoring_intro_highlight">nur ausgewählte Apps zulassen</string>
    <string name="app_monitoring_intro_action">Ich verstehe</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Funktionseinführung</string>
    <string name="emergency_call_intro_desc">Um die Sicherheit zu gewährleisten, ruft die App automatisch die Schnellkontaktliste an, wenn 10 Stunden lang keine Benutzerinteraktion am Telefon erkannt wird.</string>
    <string name="emergency_call_intro_highlight">automatisch die Schnellkontaktliste anrufen</string>
    <string name="emergency_call_intro_action">Ich verstehe</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Funktionseinführung</string>
    <string name="file_cleanup_intro_desc">Diese Funktion schützt Benutzer, indem sie automatisch unbekannte Installationsdateien (APK) löscht, die auf das Gerät heruntergeladen wurden, um die versehentliche Installation von Malware zu vermeiden.</string>
    <string name="file_cleanup_intro_highlight">automatisches Löschen unbekannter Installationsdateien (APK)</string>
    <string name="file_cleanup_intro_action">Ich verstehe</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Funktionseinführung</string>
    <string name="call_block_intro_desc">Diese Funktion schützt Benutzer, indem sie automatisch Anrufe von unbekannten Nummern blockiert, die nicht in den Kontakten enthalten sind, um Belästigungen durch Werbung oder Betrug zu vermeiden.</string>
    <string name="call_block_intro_highlight">automatisches Blockieren von Anrufen von unbekannten Nummern</string>
    <string name="call_block_intro_action">Ich verstehe</string>

    <!-- Overlay Permission -->
    <string name="overlay_permission_title">Über anderen Apps anzeigen</string>
    <string name="overlay_permission_desc">Die App benötigt die Berechtigung „Über anderen Apps anzeigen“, um den Sperrbildschirm anzuzeigen, wenn eine blockierte App geöffnet wird.</string>
    <string name="overlay_permission_highlight">„Über anderen Apps anzeigen“</string>
