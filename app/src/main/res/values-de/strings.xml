    <string name="default_launcher_title">Standard-Launcher festlegen</string>
    <string name="default_launcher_desc">Um den Retirement Launcher als Startbildschirm zu verwenden, müssen Sie ihn in den Systemeinstellungen als Standard-App festlegen.</string>
