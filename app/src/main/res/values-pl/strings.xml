    <string name="file_permission_title">Ochrona pamięci</string>
    <string name="file_permission_desc">Aby automatyczne usuwanie nieznanych plików APK/AAB działało, aplikacja potrzebuje dostępu do całej pamięci. Pomaga to utrzymać urządzenie w czystości i bezpieczeństwie.</string>
    <string name="file_permission_highlight">nieznane APK/AAB</string>
    <string name="usage_stats_permission_title">Monitorowanie aplikacji</string>
    <string name="usage_stats_permission_desc">Aby funkcja blokowania aplikacji działała, musisz przyznać „Dostęp do danych o użyciu”. Pomaga to aplikacji dowiedzieć się, kiedy otwierana jest nieautoryzowana aplikacja.</string>
    <string name="usage_stats_permission_highlight">„Dostęp do danych o użyciu”</string>
    <string name="accessibility_permission_title">Wykrywanie aktywności użytkownika</string>
    <string name="accessibility_permission_desc">SOS korzysta z Ułatwień dostępu wyłącznie w celu wykrycia, kiedy użytkownik zaczyna dotykać ekranu. Nie czyta zawartości ekranu, nie rejestruje tekstu, nie zmienia ustawień, nie steruje telefonem ani nie udostępnia tych danych. Sygnatura czasowa aktywności pozostaje na tym urządzeniu i jest używana wyłącznie do podjęcia decyzji, czy SOS powinien zadzwonić do kontaktów alarmowych.</string>
    <string name="accessibility_permission_highlight">nie czyta zawartości ekranu</string>
    <string name="user_activity_accessibility_service_label">Wykrywanie aktywności użytkownika SOS</string>
    <string name="user_activity_accessibility_service_summary">Wykrywa rzeczywistą aktywność użytkownika na potrzeby kontroli braku aktywności SOS.</string>
    <string name="user_activity_accessibility_service_desc">Używane wyłącznie przez Auto SOS do wykrywania, czy telefon jest nadal aktywnie używany. Usługa nasłuchuje wyłącznie zdarzenia systemowego wskazującego, że użytkownik zaczął dotykać ekranu, a następnie zapisuje czas ostatniej aktywności na tym urządzeniu. Nie czyta zawartości ekranu, nie gromadzi wpisywanego tekstu, nie sprawdza innych aplikacji, nie zmienia ustawień, nie wykonuje gestów, nie klika przycisków ani nie udostępnia tych danych o aktywności.</string>
    <string name="app_monitoring_intro_title">Wprowadzenie do funkcji</string>
    <string name="app_monitoring_intro_desc">Ta funkcja pomaga chronić użytkowników, zezwalając na uruchamianie wyłącznie wybranych aplikacji. Inne aplikacje zostaną zablokowane, aby uniknąć niezamierzonych problemów.</string>
    <string name="app_monitoring_intro_highlight">zezwalając na uruchamianie wyłącznie wybranych aplikacji</string>
    <string name="app_monitoring_intro_action">Rozumiem</string>
    <string name="emergency_call_intro_title">Wprowadzenie do funkcji</string>
    <string name="emergency_call_intro_desc">Aby zapewnić bezpieczeństwo, aplikacja automatycznie zadzwoni do listy szybkich kontaktów, jeśli przez 10 godzin nie zostanie wykryta żadna interakcja użytkownika z telefonem.</string>
    <string name="emergency_call_intro_highlight">automatycznie zadzwoni do listy szybkich kontaktów</string>
    <string name="emergency_call_intro_action">Rozumiem</string>
    <string name="file_cleanup_intro_title">Wprowadzenie do funkcji</string>
    <string name="file_cleanup_intro_desc">Ta funkcja pomaga chronić użytkowników poprzez automatyczne usuwanie nieznanych plików instalacyjnych (APK) pobranych na urządzenie, co zapobiega przypadkowej instalacji złośliwego oprogramowania.</string>
    <string name="file_cleanup_intro_highlight">automatyczne usuwanie nieznanych plików instalacyjnych (APK)</string>
    <string name="file_cleanup_intro_action">Rozumiem</string>
    <string name="call_block_intro_title">Wprowadzenie do funkcji</string>
    <string name="call_block_intro_desc">Ta funkcja pomaga chronić użytkowników poprzez automatyczne blokowanie połączeń z nieznanych numerów, których nie ma w kontaktach, co pozwala uniknąć nękania przez reklamy lub oszustwa.</string>
    <string name="call_block_intro_highlight">automatyczne blokowanie połączeń z nieznanych numerów</string>
    <string name="call_block_intro_action">Rozumiem</string>
    <string name="emergency_contact_required_title">Wymagana konfiguracja kontaktu</string>
    <string name="emergency_contact_required_desc">Nie skonfigurowano jeszcze listy szybkich kontaktów. Aby ta funkcja działała, wybierz co najmniej jeden kontakt.</string>
    <string name="emergency_contact_required_highlight">wybierz co najmniej jeden kontakt</string>
    <string name="emergency_contact_required_action">Skonfiguruj teraz</string>
