    <!-- File Permission -->
    <string name="file_permission_title">Ochrona pamięci</string>
    <string name="file_permission_desc">Aby funkcja automatycznego usuwania nieznanych plików APK/AAB działała, aplikacja potrzebuje dostępu do całej pamięci. Pomaga to utrzymać urządzenie w czystości i bezpieczeństwie.</string>
    <string name="file_permission_highlight">nieznane pliki APK/AAB</string>

    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">Monitorowanie aplikacji</string>
    <string name="usage_stats_permission_desc">Aby funkcja blokowania aplikacji działała, musisz udzielić „Dostępu do danych o użyciu”. Pomaga to aplikacji wiedzieć, kiedy otwierana jest nieautoryzowana aplikacja.</string>
    <string name="usage_stats_permission_highlight">„Dostępu do danych o użyciu”</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Wprowadzenie do funkcji</string>
    <string name="app_monitoring_intro_desc">Ta funkcja pomaga chronić użytkowników, zezwalając na działanie tylko wybranych aplikacji. Inne aplikacje zostaną zablokowane, aby uniknąć niezamierzonych problemów.</string>
    <string name="app_monitoring_intro_highlight">zezwalać na działanie tylko wybranych aplikacji</string>
    <string name="app_monitoring_intro_action">Rozumiem</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Wprowadzenie do funkcji</string>
    <string name="emergency_call_intro_desc">Aby zapewnić bezpieczeństwo, aplikacja automatycznie zadzwoni na listę szybkich kontaktów, jeśli przez 10 godzin nie zostanie wykryta żadna interakcja użytkownika z telefonem.</string>
    <string name="emergency_call_intro_highlight">automatycznie zadzwoni na listę szybkich kontaktów</string>
    <string name="emergency_call_intro_action">Rozumiem</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Wprowadzenie do funkcji</string>
    <string name="file_cleanup_intro_desc">Ta funkcja pomaga chronić użytkowników poprzez automatyczne usuwanie nieznanych plików instalacyjnych (APK) pobranych na urządzenie, co zapobiega przypadkowej instalacji złośliwego oprogramowania.</string>
    <string name="file_cleanup_intro_highlight">automatyczne usuwanie nieznanych plików instalacyjnych (APK)</string>
    <string name="file_cleanup_intro_action">Rozumiem</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Wprowadzenie do funkcji</string>
    <string name="call_block_intro_desc">Ta funkcja pomaga chronić użytkowników poprzez automatyczne blokowanie połączeń z nieznanych numerów, których nie ma w kontaktach, co pozwala uniknąć nękania reklamami lub oszustwami.</string>
    <string name="call_block_intro_highlight">automatyczne blokowanie połączeń z nieznanych numerów</string>
    <string name="call_block_intro_action">Rozumiem</string>

    <!-- Overlay Permission -->
    <string name="overlay_permission_title">Wyświetlanie nad innymi aplikacjami</string>
    <string name="overlay_permission_desc">Aplikacja potrzebuje uprawnienia „Wyświetlanie nad innymi aplikacjami”, aby pokazywać ekran blokady, gdy otwierana jest zablokowana aplikacja.</string>
    <string name="overlay_permission_highlight">„Wyświetlanie nad innymi aplikacjami”</string>
