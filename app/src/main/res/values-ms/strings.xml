    <string name="file_permission_title">Perlindungan Storan</string>
    <string name="file_permission_desc">Untuk pemadaman automatik fail APK/AAB yang tidak dikenali berfungsi, aplikasi memerlukan akses ke semua storan. Ini membantu memastikan peranti anda bersih dan selamat.</string>
    <string name="file_permission_highlight">APK/AAB tidak dikenali</string>
    <string name="usage_stats_permission_title">Pemantauan Aplikasi</string>
    <string name="usage_stats_permission_desc">Untuk ciri penyekatan aplikasi berfungsi, anda perlu memberikan \'Akses data penggunaan\'. Ini membantu aplikasi mengetahui apabila aplikasi yang tidak dibenarkan dibuka.</string>
    <string name="usage_stats_permission_highlight">\'Akses data penggunaan\'</string>
    <string name="accessibility_permission_title">Pengesanan Aktiviti Pengguna</string>
    <string name="accessibility_permission_desc">SOS menggunakan Kebolehcapaian hanya untuk mengesan apabila pengguna mula menyentuh skrin. Ia tidak membaca kandungan skrin, merekod teks, menukar tetapan, mengawal telefon, atau berkongsi data ini. Penanda masa aktiviti kekal pada peranti ini dan hanya digunakan untuk memutuskan sama ada SOS patut memanggil kenalan kecemasan.</string>
    <string name="accessibility_permission_highlight">tidak membaca kandungan skrin</string>
    <string name="user_activity_accessibility_service_label">Pengesanan Aktiviti Pengguna SOS</string>
    <string name="user_activity_accessibility_service_summary">Mengesan aktiviti pengguna sebenar untuk pemeriksaan ketidakaktifan SOS.</string>
    <string name="user_activity_accessibility_service_desc">Hanya digunakan oleh Auto SOS untuk mengesan sama ada telefon masih digunakan secara aktif. Perkhidmatan hanya mendengar acara sistem yang menunjukkan pengguna telah mula menyentuh skrin, kemudian menyimpan masa aktiviti terkini pada peranti ini. Ia tidak membaca kandungan skrin, mengumpul teks yang ditaip, memeriksa aplikasi lain, menukar tetapan, melakukan gerak isyarat, mengklik butang, atau berkongsi data aktiviti ini.</string>
    <string name="app_monitoring_intro_title">Pengenalan Ciri</string>
    <string name="app_monitoring_intro_desc">Ciri ini membantu melindungi pengguna dengan hanya membenarkan aplikasi terpilih untuk dijalankan. Aplikasi lain akan disekat untuk mengelakkan masalah yang tidak diingini.</string>
    <string name="app_monitoring_intro_highlight">hanya membenarkan aplikasi terpilih</string>
    <string name="app_monitoring_intro_action">Saya faham</string>
    <string name="emergency_call_intro_title">Pengenalan Ciri</string>
    <string name="emergency_call_intro_desc">Untuk memastikan keselamatan, aplikasi akan secara automatik memanggil senarai kenalan pantas jika tiada interaksi pengguna dikesan pada telefon selama 10 jam.</string>
    <string name="emergency_call_intro_highlight">secara automatik memanggil senarai kenalan pantas</string>
    <string name="emergency_call_intro_action">Saya faham</string>
    <string name="file_cleanup_intro_title">Pengenalan Ciri</string>
    <string name="file_cleanup_intro_desc">Ciri ini membantu melindungi pengguna dengan memadam secara automatik fail pemasangan tidak dikenali (APK) yang dimuat turun ke peranti, mengelakkan pemasangan malware secara tidak sengaja.</string>
    <string name="file_cleanup_intro_highlight">memadam secara automatik fail pemasangan tidak dikenali (APK)</string>
    <string name="file_cleanup_intro_action">Saya faham</string>
    <string name="call_block_intro_title">Pengenalan Ciri</string>
    <string name="call_block_intro_desc">Ciri ini membantu melindungi pengguna dengan menyekat secara automatik panggilan daripada nombor tidak dikenali yang tiada dalam kenalan, mengelakkan gangguan iklan atau penipuan.</string>
    <string name="call_block_intro_highlight">menyekat secara automatik panggilan daripada nombor tidak dikenali</string>
    <string name="call_block_intro_action">Saya faham</string>
    <string name="emergency_contact_required_title">Tetapan Kenalan Diperlukan</string>
    <string name="emergency_contact_required_desc">Anda belum menyediakan senarai kenalan pantas anda. Untuk ciri ini berfungsi, sila pilih sekurang-kurangnya satu kenalan.</string>
    <string name="emergency_contact_required_highlight">pilih sekurang-kurangnya satu kenalan</string>
    <string name="emergency_contact_required_action">Sediakan Sekarang</string>
