    <string name="file_permission_title">Perlindungan Storan</string>
    <string name="file_permission_desc">Untuk pemadaman automatik fail APK/AAB yang tidak dikenali berfungsi, aplikasi memerlukan akses ke semua storan. Ini membantu memastikan peranti anda bersih dan selamat.</string>
    <string name="file_permission_highlight">APK/AAB yang tidak dikenali</string>

    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">Pemantauan Aplikasi</string>
    <string name="usage_stats_permission_desc">Untuk ciri penyekatan aplikasi berfungsi, anda perlu memberikan \'Akses Data Penggunaan\'. Ini membantu aplikasi mengetahui bila aplikasi yang tidak dibenarkan dibuka.</string>
    <string name="usage_stats_permission_highlight">\'Akses Data Penggunaan\'</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Pengenalan Ciri</string>
    <string name="app_monitoring_intro_desc">Ciri ini membantu melindungi pengguna dengan hanya membenarkan aplikasi yang dipilih untuk dijalankan. Aplikasi lain akan disekat untuk mengelakkan masalah yang tidak diingini.</string>
    <string name="app_monitoring_intro_highlight">hanya membenarkan aplikasi yang dipilih</string>
    <string name="app_monitoring_intro_action">Saya faham</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Pengenalan Ciri</string>
    <string name="emergency_call_intro_desc">Untuk memastikan keselamatan, aplikasi akan menghubungi senarai hubungan pantas secara automatik jika tiada interaksi pengguna dikesan pada telefon selama 10 jam.</string>
    <string name="emergency_call_intro_highlight">menghubungi senarai hubungan pantas secara automatik</string>
    <string name="emergency_call_intro_action">Saya faham</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Pengenalan Ciri</string>
    <string name="file_cleanup_intro_desc">Ciri ini membantu melindungi pengguna dengan memadam fail pemasangan (APK) tidak dikenali yang dimuat turun ke peranti secara automatik, bagi mengelakkan pemasangan perisian hasad secara tidak sengaja.</string>
    <string name="file_cleanup_intro_highlight">memadam fail pemasangan (APK) tidak dikenali secara automatik</string>
    <string name="file_cleanup_intro_action">Saya faham</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Pengenalan Ciri</string>
    <string name="call_block_intro_desc">Ciri ini membantu melindungi pengguna dengan menyekat panggilan daripada nombor tidak dikenali yang tiada dalam hubungan secara automatik, bagi mengelakkan gangguan iklan atau penipuan.</string>
    <string name="call_block_intro_highlight">menyekat panggilan daripada nombor tidak dikenali secara automatik</string>
    <string name="call_block_intro_action">Saya faham</string>

