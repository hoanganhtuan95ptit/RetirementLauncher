    <string name="accessibility_permission_title">ব্যবহারকারীর কার্যকলাপ সনাক্তকরণ</string>
    <string name="accessibility_permission_desc">SOS শুধুমাত্র ব্যবহারকারী কখন স্ক্রিন স্পর্শ করতে শুরু করেন তা সনাক্ত করতে অ্যাক্সেসিবিলিটি ব্যবহার করে। এটি স্ক্রিন কন্টেন্ট পড়ে না, টেক্সট রেকর্ড করে না, সেটিংস পরিবর্তন করে না, ফোন নিয়ন্ত্রণ করে না বা এই ডেটা শেয়ার করে না। কার্যকলাপের টাইমস্ট্যাম্প এই ডিভাইসেই থাকে এবং শুধুমাত্র SOS জরুরি পরিচিতিগুলিতে কল করবে কিনা তা সিদ্ধান্ত নিতে ব্যবহৃত হয়।</string>
    <string name="accessibility_permission_highlight">স্ক্রিন কন্টেন্ট পড়ে না</string>
    <string name="user_activity_accessibility_service_label">SOS ব্যবহারকারীর কার্যকলাপ সনাক্তকরণ</string>
    <string name="user_activity_accessibility_service_summary">SOS নিষ্ক্রিয়তা পরীক্ষার জন্য প্রকৃত ব্যবহারকারীর কার্যকলাপ সনাক্ত করে।</string>
    <string name="user_activity_accessibility_service_desc">ফোনটি এখনও সক্রিয়ভাবে ব্যবহৃত হচ্ছে কিনা তা সনাক্ত করতে শুধুমাত্র অটো SOS দ্বারা ব্যবহৃত হয়। পরিষেবাটি শুধুমাত্র সিস্টেম ইভেন্ট শোনে যা নির্দেশ করে যে ব্যবহারকারী স্ক্রিন স্পর্শ করতে শুরু করেছেন, তারপরে এই ডিভাইসে সর্বশেষ কার্যকলাপের সময় সংরক্ষণ করে। এটি স্ক্রিন কন্টেন্ট পড়ে না, টাইপ করা টেক্সট সংগ্রহ করে না, অন্য অ্যাপগুলি পরিদর্শন করে না, সেটিংস পরিবর্তন করে না, অঙ্গভঙ্গি করে না, বোতামে ক্লিক করে না বা এই কার্যকলাপের ডেটা শেয়ার করে না।</string>
