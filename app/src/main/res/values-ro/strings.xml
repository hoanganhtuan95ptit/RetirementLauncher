    <string name="file_permission_title">Protecție stocare</string>
    <string name="file_permission_desc">Pentru ca ștergerea automată a fișierelor APK/AAB necunoscute să funcționeze, aplicația are nevoie de acces la tot spațiul de stocare. Acest lucru ajută la menținerea dispozitivului curat și sigur.</string>
    <string name="file_permission_highlight">APK/AAB necunoscute</string>
    <string name="usage_stats_permission_title">Monitorizare aplicații</string>
    <string name="usage_stats_permission_desc">Pentru ca funcția de blocare a aplicațiilor să funcționeze, trebuie să acordați „Acces la datele de utilizare”. Acest lucru ajută aplicația să știe când este deschisă o aplicație neautorizată.</string>
    <string name="usage_stats_permission_highlight">„Acces la datele de utilizare”</string>
    <string name="accessibility_permission_title">Detectarea activității utilizatorului</string>
    <string name="accessibility_permission_desc">SOS utilizează Accesibilitatea numai pentru a detecta când utilizatorul începe să atingă ecranul. Nu citește conținutul ecranului, nu înregistrează text, nu modifică setările, nu controlează telefonul și nu partajează aceste date. Marcajul temporal al activității rămâne pe acest dispozitiv și este utilizat numai pentru a decide dacă SOS ar trebui să apeleze contactele de urgență.</string>
    <string name="accessibility_permission_highlight">nu citește conținutul ecranului</string>
    <string name="user_activity_accessibility_service_label">Detectarea activității utilizatorului SOS</string>
    <string name="user_activity_accessibility_service_summary">Detectează activitatea reală a utilizatorului pentru verificările de inactivitate SOS.</string>
    <string name="user_activity_accessibility_service_desc">Utilizat numai de Auto SOS pentru a detecta dacă telefonul este încă utilizat activ. Serviciul ascultă numai evenimentul de sistem care indică faptul că utilizatorul a început să atingă ecranul, apoi salvează ultima oră de activitate pe acest dispozitiv. Nu citește conținutul ecranului, nu colectează textul tastat, nu inspectează alte aplicații, nu modifică setări, nu efectuează gesturi, nu face clic pe butoane și nu partajează aceste date de activitate.</string>
    <string name="app_monitoring_intro_title">Introducere funcție</string>
    <string name="app_monitoring_intro_desc">Această funcție ajută la protejarea utilizatorilor prin permiterea rulării doar a aplicațiilor selectate. Celelalte aplicații vor fi blocate pentru a evita problemele nedorite.</string>
    <string name="app_monitoring_intro_highlight">permiterea rulării doar a aplicațiilor selectate</string>
    <string name="app_monitoring_intro_action">Înțeleg</string>
    <string name="emergency_call_intro_title">Introducere funcție</string>
    <string name="emergency_call_intro_desc">Pentru a asigura siguranța, aplicația va apela automat lista de contacte rapide dacă nu se detectează nicio interacțiune a utilizatorului pe telefon timp de 10 ore.</string>
    <string name="emergency_call_intro_highlight">va apela automat lista de contacte rapide</string>
    <string name="emergency_call_intro_action">Înțeleg</string>
    <string name="file_cleanup_intro_title">Introducere funcție</string>
    <string name="file_cleanup_intro_desc">Această funcție ajută la protejarea utilizatorilor prin ștergerea automată a fișierelor de instalare necunoscute (APK) descărcate pe dispozitiv, evitând instalarea accidentală de malware.</string>
    <string name="file_cleanup_intro_highlight">ștergerea automată a fișierelor de instalare necunoscute (APK)</string>
    <string name="file_cleanup_intro_action">Înțeleg</string>
    <string name="call_block_intro_title">Introducere funcție</string>
    <string name="call_block_intro_desc">Această funcție ajută la protejarea utilizatorilor prin blocarea automată a apelurilor de la numere necunoscute care nu se află în contacte, evitând deranjul cauzat de reclame sau escrocherii.</string>
    <string name="call_block_intro_highlight">blocarea automată a apelurilor de la numere necunoscute</string>
    <string name="call_block_intro_action">Înțeleg</string>
    <string name="emergency_contact_required_title">Configurarea contactului este necesară</string>
    <string name="emergency_contact_required_desc">Nu v-ați configurat încă lista de contacte rapide. Pentru ca această funcție să funcționeze, vă rugăm să selectați cel puțin un contact.</string>
