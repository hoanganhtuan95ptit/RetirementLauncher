    <!-- File Permission -->
    <string name="file_permission_title">Protecție Stocare</string>
    <string name="file_permission_desc">Pentru ca ștergerea automată a fișierelor APK/AAB necunoscute să funcționeze, aplicația are nevoie de acces la tot spațiul de stocare. Acest lucru ajută la menținerea dispozitivului curat și în siguranță.</string>
    <string name="file_permission_highlight">APK/AAB necunoscute</string>

    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">Monitorizare Aplicații</string>
    <string name="usage_stats_permission_desc">Pentru ca funcția de blocare a aplicațiilor să funcționeze, trebuie să acordați „Acces la datele de utilizare”. Acest lucru ajută aplicația să știe când este deschisă o aplicație neautorizată.</string>
    <string name="usage_stats_permission_highlight">„Acces la datele de utilizare”</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Introducere Funcție</string>
    <string name="app_monitoring_intro_desc">Această funcție ajută la protejarea utilizatorilor permitând rularea doar a aplicațiilor selectate. Alte aplicații vor fi blocate pentru a evita probleme neintenționate.</string>
    <string name="app_monitoring_intro_highlight">permite doar aplicațiile selectate</string>
    <string name="app_monitoring_intro_action">Am înțeles</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Introducere Funcție</string>
    <string name="emergency_call_intro_desc">Pentru a asigura siguranța, aplicația va apela automat lista de contacte rapide dacă nu este detectată nicio interacțiune a utilizatorului pe telefon timp de 10 ore.</string>
    <string name="emergency_call_intro_highlight">va apela automat lista de contacte rapide</string>
    <string name="emergency_call_intro_action">Am înțeles</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Introducere Funcție</string>
    <string name="file_cleanup_intro_desc">Această funcție ajută la protejarea utilizatorilor prin ștergerea automată a fișierelor de instalare (APK) necunoscute descărcate pe dispozitiv, evitând instalarea accidentală de malware.</string>
    <string name="file_cleanup_intro_highlight">ștergerea automată a fișierelor de instalare (APK) necunoscute</string>
    <string name="file_cleanup_intro_action">Am înțeles</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Introducere Funcție</string>
    <string name="call_block_intro_desc">Această funcție ajută la protejarea utilizatorilor prin blocarea automată a apelurilor de la numere necunoscute care nu se află în contacte, evitând deranjul cauzat de reclame sau înșelătorii.</string>
    <string name="call_block_intro_highlight">blocarea automată a apelurilor de la numere necunoscute</string>
    <string name="call_block_intro_action">Am înțeles</string>

