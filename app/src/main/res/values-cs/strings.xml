    <!-- File Permission -->
    <string name="file_permission_title">Ochrana úložiště</string>
    <string name="file_permission_desc">Aby automatické mazání neznámých souborů APK/AAB fungovalo, potřebuje aplikace přístup k celému úložišti. To pomáhá udržovat vaše zařízení čisté a bezpečné.</string>
    <string name="file_permission_highlight">neznámé APK/AAB</string>

    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">Sledování aplikací</string>
    <string name="usage_stats_permission_desc">Aby funkce blokování aplikací fungovala, musíte udělit „Přístup k údajům o používání“. To pomáhá aplikaci vědět, kdy je otevřena neoprávněná aplikace.</string>
    <string name="usage_stats_permission_highlight">„Přístup k údajům o používání“</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Představení funkce</string>
    <string name="app_monitoring_intro_desc">Tato funkce pomáhá chránit uživatele tím, že umožňuje spouštění pouze vybraných aplikací. Ostatní aplikace budou zablokovány, aby se předešlo nechtěným problémům.</string>
    <string name="app_monitoring_intro_highlight">povolit pouze vybrané aplikace</string>
    <string name="app_monitoring_intro_action">Rozumím</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Představení funkce</string>
    <string name="emergency_call_intro_desc">Pro zajištění bezpečnosti aplikace automaticky zavolá na seznam rychlých kontaktů, pokud na telefonu není po dobu 10 hodin zjištěna žádná interakce uživatele.</string>
    <string name="emergency_call_intro_highlight">automaticky zavolat na seznam rychlých kontaktů</string>
    <string name="emergency_call_intro_action">Rozumím</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Představení funkce</string>
    <string name="file_cleanup_intro_desc">Tato funkce pomáhá chránit uživatele automatickým mazáním neznámých instalačních souborů (APK) stažených do zařízení, čímž zabraňuje náhodné instalaci malwaru.</string>
    <string name="file_cleanup_intro_highlight">automatické mazání neznámých instalačních souborů (APK)</string>
    <string name="file_cleanup_intro_action">Rozumím</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Představení funkce</string>
    <string name="call_block_intro_desc">Tato funkce pomáhá chránit uživatele automatickým blokováním hovorů z neznámých čísel, která nejsou v kontaktech, čímž zabraňuje obtěžování reklamami nebo podvody.</string>
    <string name="call_block_intro_highlight">automatické blokování hovorů z neznámých čísel</string>
    <string name="call_block_intro_action">Rozumím</string>

    <!-- Overlay Permission -->
