    <string name="file_permission_title">Ochrana úložiště</string>
    <string name="file_permission_desc">Aby fungovalo automatické mazání neznámých souborů APK/AAB, aplikace potřebuje přístup k celému úložišti. To pomáhá udržovat vaše zařízení čisté a bezpečné.</string>
    <string name="file_permission_highlight">neznámé APK/AAB</string>
    <string name="usage_stats_permission_title">Sledování aplikací</string>
    <string name="usage_stats_permission_desc">Aby fungovala funkce blokování aplikací, musíte udělit „Přístup k datům o používání“. To aplikaci pomáhá zjistit, kdy je otevřena nepovolená aplikace.</string>
    <string name="usage_stats_permission_highlight">„Přístup k datům o používání“</string>
    <string name="accessibility_permission_title">Detekce aktivity uživatele</string>
    <string name="accessibility_permission_desc">SOS využívá Usnadnění pouze k detekci toho, kdy se uživatel začne dotýkat obrazovky. Nečte obsah obrazovky, nezaznamenává text, nemění nastavení, neovládá telefon ani tato data nesdílí. Časové razítko aktivity zůstává v tomto zařízení a používá se pouze k rozhodnutí, zda má SOS volat tísňové kontakty.</string>
    <string name="accessibility_permission_highlight">nečte obsah obrazovky</string>
    <string name="user_activity_accessibility_service_label">Detekce aktivity uživatele SOS</string>
    <string name="user_activity_accessibility_service_summary">Detekuje skutečnou aktivitu uživatele pro kontroly neaktivity SOS.</string>
    <string name="user_activity_accessibility_service_desc">Používá se pouze funkcí Auto SOS k detekci, zda je telefon stále aktivně používán. Služba naslouchá pouze systémové události, která indikuje, že se uživatel začal dotýkat obrazovky, a poté do tohoto zařízení uloží čas poslední aktivity. Nečte obsah obrazovky, neshromažďuje napsaný text, neprohlíží jiné aplikace, nemění nastavení, neprovádí gesta, nekliká na tlačítka ani nesdílí tato data o aktivitě.</string>
    <string name="app_monitoring_intro_title">Představení funkce</string>
    <string name="app_monitoring_intro_desc">Tato funkce pomáhá chránit uživatele tím, že povoluje spuštění pouze vybraných aplikací. Ostatní aplikace budou zablokovány, aby se předešlo nechtěným problémům.</string>
    <string name="app_monitoring_intro_highlight">povoluje spuštění pouze vybraných aplikací</string>
    <string name="app_monitoring_intro_action">Rozumím</string>
    <string name="emergency_call_intro_title">Představení funkce</string>
    <string name="emergency_call_intro_desc">Pro zajištění bezpečnosti aplikace automaticky zavolá na seznam rychlých kontaktů, pokud na telefonu nebude po dobu 10 hodin detekována žádná interakce uživatele.</string>
    <string name="emergency_call_intro_highlight">automaticky zavolá na seznam rychlých kontaktů</string>
    <string name="emergency_call_intro_action">Rozumím</string>
    <string name="file_cleanup_intro_title">Představení funkce</string>
    <string name="file_cleanup_intro_desc">Tato funkce pomáhá chránit uživatele automatickým mazáním neznámých instalačních souborů (APK) stažených do zařízení, čímž zabraňuje náhodné instalaci malwaru.</string>
    <string name="file_cleanup_intro_highlight">automatickým mazáním neznámých instalačních souborů (APK)</string>
    <string name="file_cleanup_intro_action">Rozumím</string>
    <string name="call_block_intro_title">Představení funkce</string>
    <string name="call_block_intro_desc">Tato funkce pomáhá chránit uživatele automatickým blokováním hovorů z neznámých čísel, která nejsou v kontaktech, čímž zabraňuje obtěžování reklamami nebo podvody.</string>
    <string name="call_block_intro_highlight">automatickým blokováním hovorů z neznámých čísel</string>
    <string name="call_block_intro_action">Rozumím</string>
    <string name="emergency_contact_required_title">Vyžadováno nastavení kontaktu</string>
    <string name="emergency_contact_required_desc">Dosud jste nenastavili svůj seznam rychlých kontaktů. Aby tato funkce fungovala, vyberte prosím alespoň jeden kontakt.</string>
    <string name="emergency_contact_required_highlight">vyberte prosím alespoň jeden kontakt</string>
    <string name="emergency_contact_required_action">Nastavit nyní</string>
