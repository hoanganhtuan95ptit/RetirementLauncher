    <string name="usage_stats_permission_highlight">\'사용 정보 접근\'</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">기능 소개</string>
    <string name="app_monitoring_intro_desc">이 기능은 선택한 앱만 실행되도록 허용하여 사용자를 보호합니다. 다른 앱은 의도하지 않은 문제를 방지하기 위해 차단됩니다.</string>
    <string name="app_monitoring_intro_highlight">선택한 앱만 허용</string>
    <string name="app_monitoring_intro_action">이해했습니다</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">기능 소개</string>
    <string name="emergency_call_intro_desc">안전을 위해 10시간 동안 휴대폰 조작이 감지되지 않으면 앱이 자동으로 빠른 연락처 목록으로 전화를 겁니다.</string>
    <string name="emergency_call_intro_highlight">자동으로 빠른 연락처 목록으로 전화 걸기</string>
    <string name="emergency_call_intro_action">이해했습니다</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">기능 소개</string>
    <string name="file_cleanup_intro_desc">이 기능은 기기에 다운로드된 알 수 없는 설치 파일(APK)을 자동으로 삭제하여 사용자를 보호하고, 악성 코드가 실수로 설치되는 것을 방지합니다.</string>
    <string name="file_cleanup_intro_highlight">알 수 없는 설치 파일(APK) 자동 삭제</string>
    <string name="file_cleanup_intro_action">이해했습니다</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">기능 소개</string>
    <string name="call_block_intro_desc">이 기능은 연락처에 없는 모르는 번호의 전화를 자동으로 차단하여 사용자를 보호하고, 광고나 사기 전화로부터 방해받는 것을 방지합니다.</string>
    <string name="call_block_intro_highlight">모르는 번호의 전화 자동 차단</string>
    <string name="call_block_intro_action">이해했습니다</string>

