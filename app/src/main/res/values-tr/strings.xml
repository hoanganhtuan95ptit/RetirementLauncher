    <!-- File Permission -->
    <string name="file_permission_title">Depolama Koruması</string>
    <string name="file_permission_desc">Bilinmeyen APK/AAB dosyalarının otomatik olarak silinmesinin çalışması için uygulamanın tüm depolama alanına erişmesi gerekir. Bu, cihazınızın temiz ve güvenli kalmasına yardımcı olur.</string>
    <string name="file_permission_highlight">bilinmeyen APK/AAB</string>

    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">Uygulama İzleme</string>
    <string name="usage_stats_permission_desc">Uygulama engelleme özelliğinin çalışması için \'Kullanım Verilerine Erişim\' izni vermeniz gerekir. Bu, uygulamanın yetkisiz bir uygulama açıldığında bunu bilmesine yardımcı olur.</string>
    <string name="usage_stats_permission_highlight">\'Kullanım Verilerine Erişim\'</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Özellik Tanıtımı</string>
    <string name="app_monitoring_intro_desc">Bu özellik, yalnızca seçilen uygulamaların çalışmasına izin vererek kullanıcıları korumaya yardımcı olur. İstenmeyen sorunları önlemek için diğer uygulamalar engellenecektir.</string>
    <string name="app_monitoring_intro_highlight">yalnızca seçilen uygulamalara izin verme</string>
    <string name="app_monitoring_intro_action">Anlıyorum</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Özellik Tanıtımı</string>
    <string name="emergency_call_intro_desc">Güvenliği sağlamak için uygulama, telefonda 10 saat boyunca herhangi bir kullanıcı etkileşimi tespit edilmezse hızlı kişi listesini otomatik olarak arayacaktır.</string>
    <string name="emergency_call_intro_highlight">hızlı kişi listesini otomatik olarak arama</string>
    <string name="emergency_call_intro_action">Anlıyorum</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Özellik Tanıtımı</string>
    <string name="file_cleanup_intro_desc">Bu özellik, cihaza indirilen bilinmeyen kurulum dosyalarını (APK) otomatik olarak silerek kullanıcıları korumaya yardımcı olur ve kötü amaçlı yazılımların yanlışlıkla yüklenmesini önler.</string>
    <string name="file_cleanup_intro_highlight">bilinmeyen kurulum dosyalarını (APK) otomatik olarak silme</string>
    <string name="file_cleanup_intro_action">Anlıyorum</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Özellik Tanıtımı</string>
    <string name="call_block_intro_desc">Bu özellik, kişilerde bulunmayan bilinmeyen numaralardan gelen aramaları otomatik olarak engelleyerek kullanıcıları korumaya yardımcı olur, reklamlar veya dolandırıcılıklar tarafından rahatsız edilmeyi önler.</string>
    <string name="call_block_intro_highlight">bilinmeyen numaralardan gelen aramaları otomatik olarak engelleme</string>
    <string name="call_block_intro_action">Anlıyorum</string>

