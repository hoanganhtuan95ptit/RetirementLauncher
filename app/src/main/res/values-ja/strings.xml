    <!-- File Permission -->
    <string name="file_permission_title">ストレージ保護</string>
    <string name="file_permission_desc">不明なAPK/AABファイルの自動削除を機能させるには、アプリがすべてのストレージにアクセスできる必要があります。これにより、デバイスをクリーンで安全に保つことができます。</string>
    <string name="file_permission_highlight">不明なAPK/AAB</string>

    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">アプリの監視</string>
    <string name="usage_stats_permission_desc">アプリブロック機能を動作させるには、「使用状況へのアクセス」を許可する必要があります。これにより、許可されていないアプリがいつ開かれたかをアプリが把握できるようになります。</string>
    <string name="usage_stats_permission_highlight">「使用状況へのアクセス」</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">機能紹介</string>
    <string name="app_monitoring_intro_desc">この機能は、選択したアプリのみの実行を許可することでユーザーを保護します。意図しない問題を防ぐため、他のアプリはブロックされます。</string>
    <string name="app_monitoring_intro_highlight">選択したアプリのみを許可</string>
    <string name="app_monitoring_intro_action">了解しました</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">機能紹介</string>
    <string name="emergency_call_intro_desc">安全を確保するため、10時間以上電話の操作が検出されない場合、アプリはクイック連絡先リストに自動的に電話をかけます。</string>
    <string name="emergency_call_intro_highlight">クイック連絡先リストに自動的に電話をかける</string>
    <string name="emergency_call_intro_action">了解しました</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">機能紹介</string>
    <string name="file_cleanup_intro_desc">この機能は、デバイスにダウンロードされた不明なインストールファイル（APK）を自動的に削除することでユーザーを保護し、マルウェアの誤ったインストールを防ぎます。</string>
    <string name="file_cleanup_intro_highlight">不明なインストールファイル（APK）を自動的に削除</string>
    <string name="file_cleanup_intro_action">了解しました</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">機能紹介</string>
    <string name="call_block_intro_desc">この機能は、連絡先にない不明な番号からの電話を自動的にブロックすることでユーザーを保護し、広告や詐欺に悩まされるのを防ぎます。</string>
    <string name="call_block_intro_highlight">不明な番号からの電話を自動的にブロック</string>
    <string name="call_block_intro_action">了解しました</string>

