    <!-- File Permission -->
    <string name="file_permission_title">Proteksyon sa Storage</string>
    <string name="file_permission_desc">Para gumana ang auto deletion ng mga hindi kilalang APK/AAB file, kailangan ng app ng access sa lahat ng storage. Nakakatulong ito para mapanatiling malinis at ligtas ang iyong device.</string>
    <string name="file_permission_highlight">hindi kilalang APK/AAB</string>

    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">Pagsubaybay sa App</string>
    <string name="usage_stats_permission_desc">Para gumana ang feature sa pag-block ng app, kailangan mong ibigay ang \'Usage Data Access\'. Nakakatulong ito sa app na malaman kung kailan binubuksan ang isang hindi awtorisadong app.</string>
    <string name="usage_stats_permission_highlight">\'Usage Data Access\'</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Pagpapakilala sa Feature</string>
    <string name="app_monitoring_intro_desc">Nakatutulong ang feature na ito na protektahan ang mga user sa pamamagitan ng pagpayag lamang sa mga napiling app na tumakbo. Ang ibang mga app ay iba-block para maiwasan ang mga hindi sinasadyang problema.</string>
    <string name="app_monitoring_intro_highlight">pagpayag lamang sa mga napiling app</string>
    <string name="app_monitoring_intro_action">Naiintindihan ko</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Pagpapakilala sa Feature</string>
    <string name="emergency_call_intro_desc">Para masiguro ang kaligtasan, awtomatikong tatawag ang app sa mabilis na listahan ng contact kung walang detektadong interaksyon ng user sa telepono sa loob ng 10 oras.</string>
    <string name="emergency_call_intro_highlight">awtomatikong tatawag sa mabilis na listahan ng contact</string>
    <string name="emergency_call_intro_action">Naiintindihan ko</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Pagpapakilala sa Feature</string>
    <string name="file_cleanup_intro_desc">Nakatutulong ang feature na ito na protektahan ang mga user sa pamamagitan ng awtomatikong pag-delete ng mga hindi kilalang installation file (APK) na na-download sa device, iniiwasan ang hindi sinasadyang pag-install ng malware.</string>
    <string name="file_cleanup_intro_highlight">awtomatikong pag-delete ng mga hindi kilalang installation file (APK)</string>
    <string name="file_cleanup_intro_action">Naiintindihan ko</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Pagpapakilala sa Feature</string>
    <string name="call_block_intro_desc">Nakatutulong ang feature na ito na protektahan ang mga user sa pamamagitan ng awtomatikong pag-block ng mga tawag mula sa mga hindi kilalang numero na wala sa mga contact, iniiwasan ang pagkakaroon ng abala mula sa mga ad o scam.</string>
    <string name="call_block_intro_highlight">awtomatikong pag-block ng mga tawag mula sa mga hindi kilalang numero</string>
    <string name="call_block_intro_action">Naiintindihan ko</string>

