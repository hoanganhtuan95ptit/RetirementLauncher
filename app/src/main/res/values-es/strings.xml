    <!-- File Permission -->
    <string name="file_permission_title">Protección de almacenamiento</string>
    <string name="file_permission_desc">Para que la eliminación automática de archivos APK/AAB desconocidos funcione, la aplicación necesita acceso a todo el almacenamiento. Esto ayuda a mantener tu dispositivo limpio y seguro.</string>
    <string name="file_permission_highlight">APK/AAB desconocidos</string>

    <!-- Usage Stats Permission -->
    <string name="usage_stats_permission_title">Monitoreo de aplicaciones</string>
    <string name="usage_stats_permission_desc">Para que la función de bloqueo de aplicaciones funcione, debes conceder \'Acceso a datos de uso\'. Esto ayuda a la aplicación a saber cuándo se abre una aplicación no autorizada.</string>
    <string name="usage_stats_permission_highlight">\'Acceso a datos de uso\'</string>

    <!-- App Monitoring Intro -->
    <string name="app_monitoring_intro_title">Introducción a la función</string>
    <string name="app_monitoring_intro_desc">Esta función ayuda a proteger a los usuarios al permitir que solo se ejecuten las aplicaciones seleccionadas. Otras aplicaciones se bloquearán para evitar problemas no deseados.</string>
    <string name="app_monitoring_intro_highlight">solo permitir aplicaciones seleccionadas</string>
    <string name="app_monitoring_intro_action">Entiendo</string>

    <!-- Emergency Call Intro -->
    <string name="emergency_call_intro_title">Introducción a la función</string>
    <string name="emergency_call_intro_desc">Para garantizar la seguridad, la aplicación llamará automáticamente a la lista de contactos rápidos si no se detecta interacción del usuario en el teléfono durante 10 horas.</string>
    <string name="emergency_call_intro_highlight">llamar automáticamente a la lista de contactos rápidos</string>
    <string name="emergency_call_intro_action">Entiendo</string>

    <!-- File Cleanup Intro -->
    <string name="file_cleanup_intro_title">Introducción a la función</string>
    <string name="file_cleanup_intro_desc">Esta función ayuda a proteger a los usuarios eliminando automáticamente archivos de instalación (APK) desconocidos descargados al dispositivo, evitando la instalación accidental de malware.</string>
    <string name="file_cleanup_intro_highlight">eliminar automáticamente archivos de instalación (APK) desconocidos</string>
    <string name="file_cleanup_intro_action">Entiendo</string>

    <!-- Call Block Intro -->
    <string name="call_block_intro_title">Introducción a la función</string>
    <string name="call_block_intro_desc">Esta función ayuda a proteger a los usuarios bloqueando automáticamente las llamadas de números desconocidos que no están en los contactos, evitando molestias por publicidad o estafas.</string>
    <string name="call_block_intro_highlight">bloquear automáticamente llamadas de números desconocidos</string>
    <string name="call_block_intro_action">Entiendo</string>

