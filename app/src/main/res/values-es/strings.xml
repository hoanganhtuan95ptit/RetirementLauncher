    <string name="file_permission_title">Protección de Almacenamiento</string>
    <string name="file_permission_desc">Para que la eliminación automática de archivos APK/AAB desconocidos funcione, la aplicación necesita acceso a todo el almacenamiento. Esto ayuda a mantener su dispositivo limpio y seguro.</string>
    <string name="file_permission_highlight">APK/AAB desconocidos</string>
    <string name="usage_stats_permission_title">Monitoreo de Aplicaciones</string>
    <string name="usage_stats_permission_desc">Para que la función de bloqueo de aplicaciones funcione, debe otorgar \'Acceso a datos de uso\'. Esto ayuda a la aplicación a saber cuándo se abre una aplicación no autorizada.</string>
    <string name="usage_stats_permission_highlight">\'Acceso a datos de uso\'</string>
    <string name="accessibility_permission_title">Detección de Actividad del Usuario</string>
    <string name="accessibility_permission_desc">SOS utiliza la Accesibilidad solo para detectar cuándo el usuario comienza a tocar la pantalla. No lee el contenido de la pantalla, ni registra texto, ni cambia ajustes, ni controla el teléfono, ni comparte estos datos. La marca de tiempo de la actividad permanece en este dispositivo y se utiliza solo para decidir si SOS debe llamar a los contactos de emergencia.</string>
    <string name="accessibility_permission_highlight">no lee el contenido de la pantalla</string>
    <string name="user_activity_accessibility_service_label">Detección de Actividad de Usuario SOS</string>
    <string name="user_activity_accessibility_service_summary">Detecta la actividad real del usuario para las comprobaciones de inactividad de SOS.</string>
    <string name="user_activity_accessibility_service_desc">Utilizado solo por SOS Automático para detectar si el teléfono sigue siendo utilizado activamente. El servicio escucha solo el evento del sistema que indica que el usuario ha comenzado a tocar la pantalla, luego guarda la última hora de actividad en este dispositivo. No lee el contenido de la pantalla, ni recopila texto escrito, ni inspecciona otras aplicaciones, ni cambia ajustes, ni realiza gestos, ni pulsa botones, ni comparte estos datos de actividad.</string>
    <string name="app_monitoring_intro_title">Introducción a la Función</string>
    <string name="app_monitoring_intro_desc">Esta función ayuda a proteger a los usuarios permitiendo que solo se ejecuten las aplicaciones seleccionadas. Otras aplicaciones serán bloqueadas para evitar problemas no deseados.</string>
    <string name="app_monitoring_intro_highlight">permitiendo que solo se ejecuten las aplicaciones seleccionadas</string>
    <string name="app_monitoring_intro_action">Lo entiendo</string>
    <string name="emergency_call_intro_title">Introducción a la Función</string>
    <string name="emergency_call_intro_desc">Para garantizar la seguridad, la aplicación llamará automáticamente a la lista de contactos rápidos si no se detecta interacción del usuario en el teléfono durante 10 horas.</string>
    <string name="emergency_call_intro_highlight">llamará automáticamente a la lista de contactos rápidos</string>
    <string name="emergency_call_intro_action">Lo entiendo</string>
    <string name="file_cleanup_intro_title">Introducción a la Función</string>
    <string name="file_cleanup_intro_desc">Esta función ayuda a proteger a los usuarios eliminando automáticamente los archivos de instalación desconocidos (APK) descargados al dispositivo, evitando la instalación accidental de malware.</string>
    <string name="file_cleanup_intro_highlight">eliminando automáticamente los archivos de instalación desconocidos (APK)</string>
    <string name="file_cleanup_intro_action">Lo entiendo</string>
    <string name="call_block_intro_title">Introducción a la Función</string>
    <string name="call_block_intro_desc">Esta función ayuda a proteger a los usuarios bloqueando automáticamente las llamadas de números desconocidos que no están en los contactos, evitando molestias de publicidad o estafas.</string>
    <string name="call_block_intro_highlight">bloqueando automáticamente las llamadas de números desconocidos</string>
    <string name="call_block_intro_action">Lo entiendo</string>
    <string name="emergency_contact_required_title">Configuración de Contacto Requerida</string>
    <string name="emergency_contact_required_desc">Aún no ha configurado su lista de contactos rápidos. Para que esta función funcione, por favor seleccione al menos un contacto.</string>
    <string name="emergency_contact_required_highlight">seleccione al menos un contacto</string>
    <string name="emergency_contact_required_action">Configurar Ahora</string>
    <string name="overlay_permission_title">Mostrar Sobre Otras Aplicaciones</string>
    <string name="overlay_permission_desc">La aplicación necesita el permiso de \'Mostrar sobre otras aplicaciones\' para mostrar la pantalla de bloqueo cuando se abre una aplicación bloqueada.</string>
    <string name="overlay_permission_highlight">\'Mostrar sobre otras aplicaciones\'</string>
